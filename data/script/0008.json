{"schema":"mao-cross-channel-public-site-data/1","script":"0008","rows":[{"ref":"ccfc:sn:0008:000000f3:text","row":3795,"ordinal":1,"kind":"text","jp":"「さてと、あとは支倉先輩か」","en":"“Now, that leaves Hasekura.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000023b:text","row":3796,"ordinal":2,"kind":"text","jp":"「ここでもない」","en":"“Not here.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000288:text","row":3797,"ordinal":3,"kind":"text","jp":"「あそこでもない」","en":"“Not there, either.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000002ba:text","row":3798,"ordinal":4,"kind":"text","jp":"「……………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000003dd:text","row":3799,"ordinal":5,"kind":"text","jp":"「……ふっ、そうだ、俺は支倉先輩の家を知らなかったな」","en":"“Oh. Right. I have no idea where Hasekura lives.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000005d0:text","row":3800,"ordinal":6,"kind":"text","jp":"「あれ、あなたは……」","en":"“Wait, aren’t you...?”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000623:text","row":3801,"ordinal":7,"kind":"text","jp":"「キミは福原か」","en":"“You’re Fukuhara.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000670:text","row":3802,"ordinal":8,"kind":"text","jp":"「ど、どうも」","en":"“H-hello.”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:000006bb:text","row":3803,"ordinal":9,"kind":"text","jp":"「そうだ、支倉先輩の家を知ってるかい」","en":"“Do you know where Hasekura lives?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000071e:text","row":3804,"ordinal":10,"kind":"text","jp":"「支倉さんですか？」","en":"“Hasekura?”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000752:text","row":3805,"ordinal":11,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:0000079b:text","row":3806,"ordinal":12,"kind":"text","jp":"「ええっと……黒髪ロングでクールな女性ですか？」","en":"“Um... the cool woman with long black hair?”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000808:text","row":3807,"ordinal":13,"kind":"text","jp":"「多分そんな感じの女性だ」","en":"“That probably describes her.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000085f:text","row":3808,"ordinal":14,"kind":"text","jp":"「その方でしたら、この近くに住んでられますよ。以前に配達で行ったことがありますし」","en":"“If that’s who you mean, she lives nearby. I delivered something to her once.”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:000008ee:text","row":3809,"ordinal":15,"kind":"text","jp":"「物知りだな」","en":"“You sure know a lot.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000939:text","row":3810,"ordinal":16,"kind":"text","jp":"「いえ、珍しい苗字ですからね」","en":"“It’s an unusual surname.”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000994:text","row":3811,"ordinal":17,"kind":"text","jp":"「で、そこに行くには」","en":"“How do I get there?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000009e7:text","row":3812,"ordinal":18,"kind":"text","jp":"「あっ、はい、ここを少し行って曲がって……」","en":"“Oh—just keep going this way, then turn...”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000a50:text","row":3813,"ordinal":19,"kind":"text","jp":"「ありがとう、行ってみる」","en":"“Thanks. I’ll check it out.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000aa7:text","row":3814,"ordinal":20,"kind":"text","jp":"「いえ、どういたしまして」","en":"“You’re welcome.”","speakerJa":"福原","speakerEn":"Fukuhara","ghs":[]},{"ref":"ccfc:sn:0008:00000b0e:text","row":3815,"ordinal":21,"kind":"text","jp":"「自宅にはいなかったか……」","en":"“So she wasn’t home...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000b67:text","row":3816,"ordinal":22,"kind":"text","jp":"「仕方ない、気分で探してみるか」","en":"“Oh well. I’ll follow my instincts.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000c96:text","row":3817,"ordinal":23,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000dbc:text","row":3818,"ordinal":24,"kind":"text","jp":"「ん？　ここはどこだ……」","en":"“Hm? Where am I...?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000e7d:text","row":3819,"ordinal":25,"kind":"text","jp":"「……桜庭浩？」","en":"“...Hiroshi Sakuraba?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00000eca:text","row":3820,"ordinal":26,"kind":"text","jp":"「ふっ、やはり俺の勘はただしい」","en":"“Hmph. My instincts were right after all.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000f27:text","row":3821,"ordinal":27,"kind":"text","jp":"「私を探しにここへ？」","en":"“You came here looking for me?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00000f7a:text","row":3822,"ordinal":28,"kind":"text","jp":"「ええ、ちょっと渡したいものがあって」","en":"“Yes. I have something for you.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00000fdd:text","row":3823,"ordinal":29,"kind":"text","jp":"「……渡したいものって何？」","en":"“...What is it?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001036:text","row":3824,"ordinal":30,"kind":"text","jp":"「写真です。部室の中から太一の写真が入ったデジタルカメラを見つけたんで、みんなに配っているんです」","en":"“A photograph. I found a digital camera with pictures of Taichi in the clubroom, and I’ve been giving copies to everyone.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000010b8:text","row":3825,"ordinal":31,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001101:text","row":3826,"ordinal":32,"kind":"text","jp":"「どうぞ」","en":"“Here.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001149:text","row":3827,"ordinal":33,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000011b0:text","row":3828,"ordinal":34,"kind":"text","jp":"「……最近、どうですか？」","en":"“...How have you been?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001207:text","row":3829,"ordinal":35,"kind":"text","jp":"「どうって、何が？」","en":"“What do you mean?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001258:text","row":3830,"ordinal":36,"kind":"text","jp":"「学校で見かけないなぁって」","en":"“I haven’t seen you at school.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000012b1:text","row":3831,"ordinal":37,"kind":"text","jp":"「そう。それで？」","en":"“I see. And?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001300:text","row":3832,"ordinal":38,"kind":"text","jp":"「元気ですか？」","en":"“Are you well?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000134d:text","row":3833,"ordinal":39,"kind":"text","jp":"「どう見える？」","en":"“How do I look?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000139a:text","row":3834,"ordinal":40,"kind":"text","jp":"「……健康そうだけど、元気はなさそうです」","en":"“...Healthy. Not happy.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000013e4:text","row":3835,"ordinal":41,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000142d:text","row":3836,"ordinal":42,"kind":"text","jp":"「バカな写真ばかりでしょ？」","en":"“They’re all ridiculous pictures, aren’t they?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001486:text","row":3837,"ordinal":43,"kind":"text","jp":"「そうね」","en":"“Yes.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000014cd:text","row":3838,"ordinal":44,"kind":"text","jp":"「まったく、あいつがいた時はいつも何か事件がおきて、痛い目にあってばかりでした」","en":"“When he was around, something was always going wrong, and I was always the one paying for it.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000153d:text","row":3839,"ordinal":45,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001586:text","row":3840,"ordinal":46,"kind":"text","jp":"「その健康診断のときなんて、裏切るし……」","en":"“He even betrayed me during that physical...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000015ed:text","row":3841,"ordinal":47,"kind":"text","jp":"「でも、今にして思うと、楽しかったっていうか……」","en":"“But looking back, I suppose it was fun...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000165c:text","row":3842,"ordinal":48,"kind":"text","jp":"「要らない」","en":"“I don’t want it.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000016a5:text","row":3843,"ordinal":49,"kind":"text","jp":"「えっ……？」","en":"“What...?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000016f0:text","row":3844,"ordinal":50,"kind":"text","jp":"「写真、要らないから」","en":"“Um... but...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001743:text","row":3845,"ordinal":51,"kind":"text","jp":"「えっと……それは……」","en":"“Um... Why not?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001798:text","row":3846,"ordinal":52,"kind":"text","jp":"「……データ、持ってるから」","en":"“...I have the original files.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000017d4:text","row":3847,"ordinal":53,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000181d:text","row":3848,"ordinal":54,"kind":"text","jp":"「……全部私が撮ったものだから」","en":"“...I took every one of them.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000187a:text","row":3849,"ordinal":55,"kind":"text","jp":"「なるほど」","en":"“I see.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001924:text","row":3850,"ordinal":56,"kind":"text","jp":"「過去は、まだいらない。太一の今が必要……」","en":"“I don’t need the past. Not yet. I need Taichi as he is now...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000198d:text","row":3851,"ordinal":57,"kind":"text","jp":"「……ラジオなら、今がわかるんじゃ？」","en":"“...Wouldn’t the radio tell you how he is now?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000019d3:text","row":3852,"ordinal":58,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001a1c:text","row":3853,"ordinal":59,"kind":"text","jp":"「あれなら、毎週、あいつの今が聴けるんじゃ……」","en":"“That way, you could hear how he’s doing every week...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001aea:text","row":3854,"ordinal":60,"kind":"text","jp":"「……あなた、聴いてる？」","en":"“...Do you listen?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001b41:text","row":3855,"ordinal":61,"kind":"text","jp":"「たまにだけ」","en":"“Sometimes.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001b8c:text","row":3856,"ordinal":62,"kind":"text","jp":"「私はずっと聴いてた」","en":"“I used to listen all the time.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001bdf:text","row":3857,"ordinal":63,"kind":"text","jp":"「……過去形？」","en":"“...Past tense?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001c2c:text","row":3858,"ordinal":64,"kind":"text","jp":"「でも、そこに置いてあるのは……ラジオですよね？」","en":"“But that’s a radio sitting right there, isn’t it?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001c9b:text","row":3859,"ordinal":65,"kind":"text","jp":"「……ここなら受信するんじゃないかと思って、毎日ここに来てる」","en":"“...I thought I might pick up the signal here. That’s why I come every day.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001d16:text","row":3860,"ordinal":66,"kind":"text","jp":"「どういうことですか？」","en":"“What do you mean?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001dcc:text","row":3861,"ordinal":67,"kind":"text","jp":"「半年前かな……宮澄さんの卒業式の日の放送を最後に、放送が止まったの」","en":"“About six months ago... The broadcast on Miyasumi’s graduation day was the last one. Then the signal went dead.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001e4f:text","row":3862,"ordinal":68,"kind":"text","jp":"「放送が止まった……サボってるだけでは？」","en":"“The signal went dead... Maybe he’s just been slacking off?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001f17:text","row":3863,"ordinal":69,"kind":"text","jp":"「太一は理由もなく放送をやめないはず」","en":"“Taichi wouldn’t stop broadcasting for no reason.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00001f7a:text","row":3864,"ordinal":70,"kind":"text","jp":"「まあ、そうかもしれませんね」","en":"“No. I suppose not.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00001fd5:text","row":3865,"ordinal":71,"kind":"text","jp":"「あれは一人でも大丈夫だっていうあいつの精一杯の強がりでしょう」","en":"“That show is his way of putting on a brave face—of insisting he’s fine on his own.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002052:text","row":3866,"ordinal":72,"kind":"text","jp":"「たとえ一瞬でも、誰かとつながる瞬間が欲しいっていう」","en":"“Even though what he really wants is a moment—any moment—of connection with someone.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000020c5:text","row":3867,"ordinal":73,"kind":"text","jp":"「そんなこと、あなたに言われなくてもわかってる」","en":"“I know that without you telling me.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00002115:text","row":3868,"ordinal":74,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000021bf:text","row":3869,"ordinal":75,"kind":"text","jp":"「だから、太一が放送をやめたのには理由があるはず」","en":"“That’s why there must be a reason he stopped.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000222e:text","row":3870,"ordinal":76,"kind":"text","jp":"「放送が止まった理由」","en":"“Why the broadcasts stopped...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002264:text","row":3871,"ordinal":77,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000022ad:text","row":3872,"ordinal":78,"kind":"text","jp":"「理由になりそうなものは無かったんですか？　最後の放送に」","en":"“Was there nothing in the final broadcast that might explain it?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002385:text","row":3873,"ordinal":79,"kind":"text","jp":"「……私には、何もないように感じた」","en":"“...Nothing I could hear.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000023e6:text","row":3874,"ordinal":80,"kind":"text","jp":"「何度も繰り返し聴いたけれど、どう聴いてもいつもの太一だった……」","en":"“I played it over and over, but no matter how carefully I listened, he sounded like the same old Taichi...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00002465:text","row":3875,"ordinal":81,"kind":"text","jp":"「だとしたら……放送の後から次の放送までに、何かが起きた……」","en":"“Then something must have happened after that show, before the next one was due...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000024e0:text","row":3876,"ordinal":82,"kind":"text","jp":"「最悪のケースは……」","en":"“The worst possibility is...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002594:text","row":3877,"ordinal":83,"kind":"text","jp":"「……そんなことない」","en":"“...No. That didn’t happen.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000025e7:text","row":3878,"ordinal":84,"kind":"text","jp":"「なぜです？」","en":"“How can you be sure?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002632:text","row":3879,"ordinal":85,"kind":"text","jp":"「あの世界は、永遠の世界。たとえあの太一が死んだとしても、次の太一が生きているはず」","en":"“That world is eternal. Even if that Taichi died, the next Taichi would still be alive there.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000026c3:text","row":3880,"ordinal":86,"kind":"text","jp":"「そういう世界ですか……」","en":"“So that is how the world works...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000271a:text","row":3881,"ordinal":87,"kind":"text","jp":"「最後の放送って聴けますか？」","en":"“May I hear the final broadcast?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002775:text","row":3882,"ordinal":88,"kind":"text","jp":"「これよ……」","en":"“Here...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000287d:text","row":3883,"ordinal":89,"kind":"text","jp":"「こちらは群青学院放送部です。生きている人、いますか？」","en":"“This is the Gunjo Academy Broadcasting Club. Is anyone alive out there?”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:000028d9:text","row":3884,"ordinal":90,"kind":"text","jp":"「というわけで、どうも～！　黒須太一です。暑い日が続きますねぇ……」","en":"“And with that—hello! Taichi Kurosu here. Hot weather we’ve been having...”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:0000293d:text","row":3885,"ordinal":91,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00002969:text","row":3886,"ordinal":92,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00002999:text","row":3887,"ordinal":93,"kind":"text","jp":"「俺の一週間といえばですね、相変わらず９月６日から１２日までの繰り返しだったわけですが、世の中は卒業シーズンですね」","en":"“As for my week, it was the usual loop from September sixth through the twelfth. Out in the rest of the world, though, graduation season has arrived.”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002a31:text","row":3888,"ordinal":94,"kind":"text","jp":"「俺の記憶が確かならば、我が放送部の部長こと、みみ先輩がおとといあたりに卒業式を迎えてるはずです」","en":"“If memory serves, Mimi—our illustrious club president—should have graduated the day before yesterday.”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002ab7:text","row":3889,"ordinal":95,"kind":"text","jp":"「まあ、群青というのはアレがアレなんで、３年生だからって卒業できるとは限らないわけですが、きっとみみ先輩は大丈夫でしょう」","en":"“Granted, with Gunjo being what it is, reaching your third year doesn’t guarantee graduation. But I’m sure Mimi made it.”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002b55:text","row":3890,"ordinal":96,"kind":"text","jp":"「そうそう、このラジオも今日で卒業です。何を卒業かって？」","en":"“And speaking of graduation, this show is graduating today too. From what, you ask?”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002bb3:text","row":3891,"ordinal":97,"kind":"text","jp":"「それはもう、童貞を卒業……ではなく、あらたな方式を導入するといいますか」","en":"“Virginity—no, no. What I mean is, we’re moving to a new format.”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002c21:text","row":3892,"ordinal":98,"kind":"text","jp":"「ま、詳細は来週の放送で発表するので、お楽しみに。それでは今日の一曲目。俺の思い出のナンバー、『ボロネーゼdeそりゃねーぜ』……聴いてください……」","en":"“I’ll reveal the details next week, so stay tuned. Now for our first song, a number steeped in memories: ‘Bolognese? Oh, Please!’ ...Take it away...”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002da8:text","row":3893,"ordinal":99,"kind":"text","jp":"「……というわけで、今週の放送はここまで。お相手は女の子の味方、そして世の中すべてのイケメンの敵・黒須太一でした。それじゃあまた来週………………寝ろ！」","en":"“And that brings this week’s broadcast to a close. Your host was Taichi Kurosu: friend to every girl, sworn enemy of every handsome man alive. See you next week... GO TO SLEEP!”","speakerJa":"太一の声","speakerEn":"Taichi's Voice","ghs":[]},{"ref":"ccfc:sn:0008:00002fc2:text","row":3894,"ordinal":100,"kind":"text","jp":"「……聴いた感じでは、別段変わったところはないですね」","en":"“...Nothing in it sounds unusual to me.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00003035:text","row":3895,"ordinal":101,"kind":"text","jp":"「やっぱり、そう思う？」","en":"“You think so too?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000308a:text","row":3896,"ordinal":102,"kind":"text","jp":"「はい……この次の放送をやめようって感じは受けないです」","en":"“Yes... It doesn’t sound as though he was planning to cancel the next broadcast.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000030ff:text","row":3897,"ordinal":103,"kind":"text","jp":"「まあ、待つしかないですね」","en":"“Then I suppose all we can do is wait.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000031b9:text","row":3898,"ordinal":104,"kind":"text","jp":"「……待ち続けろというの？」","en":"“...You expect me to wait forever?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00003212:text","row":3899,"ordinal":105,"kind":"text","jp":"「そうです。あいつからの情報、という意味では待つしかありません」","en":"“If what you want is information from him, then yes. We can only wait.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00003272:text","row":3900,"ordinal":106,"kind":"text","jp":"「…………」","en":"“...”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000331c:text","row":3901,"ordinal":107,"kind":"text","jp":"「なに？」","en":"“What?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:00003363:text","row":3902,"ordinal":108,"kind":"text","jp":"「待つのは辞めませんか」","en":"“What if we stop waiting?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000033b8:text","row":3903,"ordinal":109,"kind":"text","jp":"「忘れろってこと？　そんなことできない」","en":"“You mean forget him? I can’t.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000341d:text","row":3904,"ordinal":110,"kind":"text","jp":"「違います、待つのを辞めるんです」","en":"“No. I mean stop waiting.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:0000347c:text","row":3905,"ordinal":111,"kind":"text","jp":"「？」","en":"“?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:000034bf:text","row":3906,"ordinal":112,"kind":"text","jp":"「こっちの放送を届ければいいんですよ」","en":"“We send him a broadcast of our own.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:00003522:text","row":3907,"ordinal":113,"kind":"text","jp":"「……！？」","en":"“...!?”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[]},{"ref":"ccfc:sn:0008:0000356b:text","row":3908,"ordinal":114,"kind":"text","jp":"「あいつの放送がこっちの世界に届くなら、逆もできるはず」","en":"“If his signal can reach our world, the reverse should be possible too.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]},{"ref":"ccfc:sn:0008:000035e0:text","row":3909,"ordinal":115,"kind":"text","jp":"「たまにはやりませんか、部活？」","en":"“Why don’t we do some club work for once?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[]}]}

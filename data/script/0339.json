{"schema":"mao-cross-channel-public-site-data/1","script":"0339","rows":[{"ref":"ccfc:sn:0339:0000010c:text","row":46993,"ordinal":1,"kind":"text","jp":"通過して、美希の住んでいる団地方面に向かう。","en":"I pass through and head toward the apartment complex where Miki lives.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910970","unitId":"ghs-tl:ccd4001:00001","en":"Passing through, I turn towards the direction of the apartment complex that Miki lives in.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000150:text","row":46994,"ordinal":2,"kind":"text","jp":"坂の下から小走りに駆けてくる美希。","en":"Miki comes trotting up the hill from below.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910971","unitId":"ghs-tl:ccd4001:00002","en":"Miki comes, running at a half-trot from the foot of the hill.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000018a:text","row":46995,"ordinal":3,"kind":"text","jp":"俺を見つける。","en":"She spots me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910972","unitId":"ghs-tl:ccd4001:00003","en":"She sees me.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000001b0:text","row":46996,"ordinal":4,"kind":"text","jp":"駆け出す。","en":"She breaks into a run.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910973","unitId":"ghs-tl:ccd4001:00004","en":"she breaks into a run,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000001d2:text","row":46997,"ordinal":5,"kind":"text","jp":"こっちに向かって。","en":"Straight toward me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910974","unitId":"ghs-tl:ccd4001:00005","en":"towards where I am,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000001fc:text","row":46998,"ordinal":6,"kind":"text","jp":"蹴つまずきながら。","en":"Stumbling as she comes.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910975","unitId":"ghs-tl:ccd4001:00006","en":"despite a stumble.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000024b:text","row":46999,"ordinal":7,"kind":"text","jp":"「うわ～～～～～～んっ！！」","en":"“Waaaaaaaaah!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910976","unitId":"ghs-tl:ccd4001:00007","en":"Miki: \"BWAAA～～～～～～HAAA!!!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000027f:text","row":47000,"ordinal":8,"kind":"text","jp":"泣く。","en":"She bursts into tears.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910977","unitId":"ghs-tl:ccd4001:00008","en":"Crying.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000029d:text","row":47001,"ordinal":9,"kind":"text","jp":"胸に飛び込んできた。","en":"And flings herself against my chest.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910978","unitId":"ghs-tl:ccd4001:00009","en":"She flew into my chest.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000003a1:text","row":47002,"ordinal":10,"kind":"text","jp":"受け止めた。","en":"I catch her.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910979","unitId":"ghs-tl:ccd4001:00010","en":"I catch her.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000003ea:text","row":47003,"ordinal":11,"kind":"text","jp":"「せんぱい、せんぱいせんぱいせんぱーーーーーいっ！！」","en":"“Taichi, Taichi, Taichi, Taiiiiiichiiii!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910980","unitId":"ghs-tl:ccd4001:00011","en":"Miki: \"Senpai, SenpaiSenpaiSenpaaaaaai!!!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000045d:text","row":47004,"ordinal":12,"kind":"text","jp":"「誰もいないよ～～～～～～っ！　おかしいよ～～～～～～っ、こんなの絶対おかしいよ～～～～～～っ！！」","en":"“There’s nobody anywhere! It’s not right! This can’t be right! It just can’t!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910981","unitId":"ghs-tl:ccd4001:00012","en":"Miki: \"There's no ooo~ne! It's weee~~ird, this is totally weee~ird!!!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000004e1:text","row":47005,"ordinal":13,"kind":"text","jp":"「……う、うん」","en":"“...Y-yeah.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910982","unitId":"ghs-tl:ccd4001:00013","en":"Taichi: \"...y-, yes.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000052e:text","row":47006,"ordinal":14,"kind":"text","jp":"「どこの家にも誰もいないです！　ほんとに誰もいないんです、いなくなっちゃってます！！」","en":"“There’s nobody home anywhere! Nobody, really nobody—they’ve all disappeared!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910983","unitId":"ghs-tl:ccd4001:00014","en":"Miki: \"There is no one inside anyone's house! There's really no one, they're all gone, all!!!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000005a4:text","row":47007,"ordinal":15,"kind":"text","jp":"「そうだな。困ったな」","en":"“Yeah. We’re in trouble.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910984","unitId":"ghs-tl:ccd4001:00015","en":"Taichi: \"That's right. That's so troubling.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000005d2:text","row":47008,"ordinal":16,"kind":"text","jp":"背を叩いてなだめる。","en":"I pat her back and try to soothe her.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910985","unitId":"ghs-tl:ccd4001:00016","en":"I soothe her by patting her back.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000623:text","row":47009,"ordinal":17,"kind":"text","jp":"「どういうことっすか……こんなこと、あったらだめです……」","en":"“What’s going on...? This shouldn’t be happening... It just shouldn’t...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910986","unitId":"ghs-tl:ccd4001:00017","en":"Miki: \"What's even this... this, this just can't be...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000675:text","row":47010,"ordinal":18,"kind":"text","jp":"小さいやつ。","en":"Such a little thing.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910987","unitId":"ghs-tl:ccd4001:00018","en":"What a tiny little gal.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000699:text","row":47011,"ordinal":19,"kind":"text","jp":"無敵の美希に育つのに、どれだけの幸福と偶然と時間が必要なのだろう。","en":"How much happiness, how many lucky breaks, how much time would it take for her to become that invincible Miki?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910988","unitId":"ghs-tl:ccd4001:00019","en":"For Miki to grow up to be indomitable, how much happiness and coincidences and time would be required?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000006fb:text","row":47012,"ordinal":20,"kind":"text","jp":"「俺がいるだろ」","en":"“You’ve got me.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910989","unitId":"ghs-tl:ccd4001:00020","en":"Taichi: \"I'm still with you, you know.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000748:text","row":47013,"ordinal":21,"kind":"text","jp":"「……うううっ、はい……よかった……いてくれて……」","en":"“...Uuuuh... Yes... Thank goodness... Thank goodness you’re here...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910990","unitId":"ghs-tl:ccd4001:00021","en":"Miki: \"...sob, sob, yes... so happy... that you're here...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000007b9:text","row":47014,"ordinal":22,"kind":"text","jp":"「朝おきて、お母さんとかいなくて、ごはんもなくて……そんでみんなまでいなくなってたらって考えたら……」","en":"“When I woke up, my mom wasn’t there, and there was no breakfast... and then I thought, what if everyone else was gone too...?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910991","unitId":"ghs-tl:ccd4001:00022","en":"Miki: \"I woke up this morning, and mother wasn't there, and there wasn't to eat... and that's why I started thinking, what if everybody else is gone too, and...\"","verdict":"questionable","categories":["grammar","omission"]}]},{"ref":"ccfc:sn:0339:0000083f:text","row":47015,"ordinal":23,"kind":"text","jp":"「恐くなっちゃったか」","en":"“That scared you, huh.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910992","unitId":"ghs-tl:ccd4001:00023","en":"Taichi: \"And you got frightened?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000086d:text","row":47016,"ordinal":24,"kind":"text","jp":"額をすりつけるよう、こくこくと頷く。","en":"She rubs her forehead against me, nodding and nodding.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:910993","unitId":"ghs-tl:ccd4001:00024","en":"Bob bob, a steady nod that rubs her forehead on me.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000008ce:text","row":47017,"ordinal":25,"kind":"text","jp":"「いやです、こんなの……わたし、いや……」","en":"“I hate this... I don’t want this...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910994","unitId":"ghs-tl:ccd4001:00025","en":"Miki: \"I don't like it, not this... I don't like it...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000918:text","row":47018,"ordinal":26,"kind":"text","jp":"「やっぱり人がいないと寂しいよな」","en":"“It gets lonely with no one else around, doesn’t it?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910995","unitId":"ghs-tl:ccd4001:00026","en":"Taichi: \"Indeed it's lonely when people aren't there.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000977:text","row":47019,"ordinal":27,"kind":"text","jp":"「……帰りたい……」","en":"“...I want to go home...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910996","unitId":"ghs-tl:ccd4001:00027","en":"Miki: \"...wanna go home...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000009ab:text","row":47020,"ordinal":28,"kind":"text","jp":"「帰りたいか」","en":"“You want to go home?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910997","unitId":"ghs-tl:ccd4001:00028","en":"Taichi: \"You wanna go home then.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000009f6:text","row":47021,"ordinal":29,"kind":"text","jp":"「帰りたい、帰りたい……」","en":"“I want to go home... I want to go home...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:910998","unitId":"ghs-tl:ccd4001:00029","en":"Miki: \"Wanna go home, I wanna go home...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000a30:text","row":47022,"ordinal":30,"kind":"text","jp":"「そうか、帰りたいか」","en":"“I see. You want to go home.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:910999","unitId":"ghs-tl:ccd4001:00030","en":"Taichi: \"Right, so you want to go home.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000a83:text","row":47023,"ordinal":31,"kind":"text","jp":"「霧ちんに会いたい……他のみんなにも……」","en":"“I want to see Kiri-kins... and everyone else too...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911000","unitId":"ghs-tl:ccd4001:00031","en":"Miki: \"I wanna see Kiri-chin... and all the others too...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000ac5:text","row":47024,"ordinal":32,"kind":"text","jp":"ハンカチを渡す。","en":"I give her my handkerchief.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911001","unitId":"ghs-tl:ccd4001:00032","en":"I give her a handkerchief.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000aed:text","row":47025,"ordinal":33,"kind":"text","jp":"みるみる染みを作った。","en":"A wet stain spreads across it in seconds.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911002","unitId":"ghs-tl:ccd4001:00033","en":"An instant later, she has left her stain on it.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000b1b:text","row":47026,"ordinal":34,"kind":"text","jp":"こぼれる少女の涙は、張力に丸まって真珠のよう。","en":"The tears spilling from her eyes bead under surface tension, round as pearls.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911003","unitId":"ghs-tl:ccd4001:00034","en":"The spilled tears of a girl grow round in their tensile strength, becoming as pearls.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000b69:text","row":47027,"ordinal":35,"kind":"text","jp":"「霧ちんかぁ」","en":"“Kiri-kins, huh?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911004","unitId":"ghs-tl:ccd4001:00035","en":"Taichi: \"Kiri-chin you say...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000b8f:text","row":47028,"ordinal":36,"kind":"text","jp":"一週間。","en":"One week.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911005","unitId":"ghs-tl:ccd4001:00036","en":"One week.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000baf:text","row":47029,"ordinal":37,"kind":"text","jp":"すべては日曜日だ。","en":"It all comes down to Sunday.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911006","unitId":"ghs-tl:ccd4001:00037","en":"Sunday is everything.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000d25:text","row":47030,"ordinal":38,"kind":"text","jp":"「えぐえぐえぐ」","en":"“Snf, snf, snf.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911007","unitId":"ghs-tl:ccd4001:00038","en":"Miki: \"Sob... sob... sob...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000d4d:text","row":47031,"ordinal":39,"kind":"text","jp":"ずっと泣きっぱなしだ。","en":"She doesn’t stop crying.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911008","unitId":"ghs-tl:ccd4001:00039","en":"She did nothing but continue to cry all along.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000d7b:text","row":47032,"ordinal":40,"kind":"text","jp":"手を繋いで学校に来てしまった。","en":"We end up walking all the way to school hand in hand.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911009","unitId":"ghs-tl:ccd4001:00040","en":"We had joined hands and had come to school.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000db9:text","row":47033,"ordinal":41,"kind":"text","jp":"「あのさ、俺はちょっと用事があるんだけど、美希はどうする？」","en":"“Listen, I’ve got something to take care of. What will you do?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911010","unitId":"ghs-tl:ccd4001:00041","en":"Taichi: \"Say now, I sort of have something I gotta take care of so... what are you going to do, Miki?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000e32:text","row":47034,"ordinal":42,"kind":"text","jp":"「ここで霧待ちします」","en":"“I’ll wait here for Kiri.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911011","unitId":"ghs-tl:ccd4001:00042","en":"Miki: \"I will wait for Kiri here.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000e68:text","row":47035,"ordinal":43,"kind":"text","jp":"「……そう」","en":"“...All right.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911012","unitId":"ghs-tl:ccd4001:00043","en":"Taichi: \"...right.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000e94:text","row":47036,"ordinal":44,"kind":"text","jp":"「じゃあまた」","en":"“See you in a bit, then.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911013","unitId":"ghs-tl:ccd4001:00044","en":"Taichi: \"Well, see ya.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000f40:text","row":47037,"ordinal":45,"kind":"text","jp":"「あ、用事終わったあと、まだ用事あるんですか？」","en":"“Oh. After you finish, do you have anything else to do?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911014","unitId":"ghs-tl:ccd4001:00045","en":"Miki: \"Ah, after you have finished with that thing, do you still have other things to do?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000f88:text","row":47038,"ordinal":46,"kind":"text","jp":"腕振り振り、そう言う。","en":"She asks, waving her arm.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911015","unitId":"ghs-tl:ccd4001:00046","en":"So she says swinging her arms around.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00000fbe:text","row":47039,"ordinal":47,"kind":"text","jp":"「ないよ」","en":"“No.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911016","unitId":"ghs-tl:ccd4001:00047","en":"Taichi: \"Nope.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001066:text","row":47040,"ordinal":48,"kind":"text","jp":"「じゃ、ここで待ってるんで……ここに……」","en":"“Then I’ll wait here... right here...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911017","unitId":"ghs-tl:ccd4001:00048","en":"Miki: \"Then... I will be waiting here... right here...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000010b0:text","row":47041,"ordinal":49,"kind":"text","jp":"「どうせなら教室で待ってたら？」","en":"“Why not wait in the classroom?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911018","unitId":"ghs-tl:ccd4001:00049","en":"Taichi: \"How come you're not waiting in the classroom?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000110d:text","row":47042,"ordinal":50,"kind":"text","jp":"「……人のいない建物に、入りたくないんです……息が、詰まりそうで」","en":"“...I don’t want to go inside a building with nobody in it... I feel like I can’t breathe.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911019","unitId":"ghs-tl:ccd4001:00050","en":"Miki: \"...I don't want to go inside a building where there's no people... I feel I won't be able to breathe.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000116f:text","row":47043,"ordinal":51,"kind":"text","jp":"「わかった。じゃすぐ済ませるから」","en":"“Okay. I’ll make it quick.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911020","unitId":"ghs-tl:ccd4001:00051","en":"Taichi: \"Gotcha. Well, if I can get this over with quick...\"","verdict":"questionable","categories":["grammar","presentation"]}]},{"ref":"ccfc:sn:0339:000011ce:text","row":47044,"ordinal":52,"kind":"text","jp":"「あ、ハンカチも……弁償します、お金以外で」","en":"“Oh, and I’ll pay you back for the handkerchief... just not with money.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911021","unitId":"ghs-tl:ccd4001:00052","en":"Miki: \"Ah, the handkerchief... I will reimburse you, but not with money.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001212:text","row":47045,"ordinal":53,"kind":"text","jp":"何でだ。","en":"With what?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911022","unitId":"ghs-tl:ccd4001:00053","en":"With what then?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001232:text","row":47046,"ordinal":54,"kind":"text","jp":"ついセクハラ魂がわきあがる。","en":"The creep in me perked right up.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911023","unitId":"ghs-tl:ccd4001:00054","en":"My Sexual Harassment Soul unconsciously boils to the surface.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000126e:text","row":47047,"ordinal":55,"kind":"text","jp":"「いいさ。女の子を泣かせたままにしておくハンカチじゃないんだよ」","en":"“Don’t worry about it. A handkerchief of mine would never leave a girl in tears.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911024","unitId":"ghs-tl:ccd4001:00055","en":"Taichi: \"It's fine. Leaving a girl crying is not worth a handkerchief.\"","verdict":"confirmed_error","categories":["mistranslation","logical_relation"],"assessment":"Taichi says that the handkerchief is not meant to leave a girl crying and dismisses reimbursement. The English instead compares the girl's crying with the handkerchief's value.","remedy":"A handkerchief isn't meant to leave a girl crying.","highlights":[{"color":"red","end":70,"start":20,"text":"Leaving a girl crying is not worth a handkerchief."}]}]},{"ref":"ccfc:sn:0339:000012eb:text","row":47048,"ordinal":56,"kind":"text","jp":"「……ぐす」","en":"“...Snf.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911025","unitId":"ghs-tl:ccd4001:00056","en":"Miki: \"...sob...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000130f:text","row":47049,"ordinal":57,"kind":"text","jp":"効果覿面(てきめん)だ。","en":"Works like a charm.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911026","unitId":"ghs-tl:ccd4001:00057","en":"Presentaneous.","verdict":"questionable","categories":["word_choice","grammar"]}]},{"ref":"ccfc:sn:0339:0000141a:text","row":47050,"ordinal":58,"kind":"text","jp":"教室。","en":"The classroom.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911027","unitId":"ghs-tl:ccd4001:00058","en":"In the classroom.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000014e6:text","row":47051,"ordinal":59,"kind":"text","jp":"霧はいない。","en":"Kiri isn’t here.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911028","unitId":"ghs-tl:ccd4001:00059","en":"Kiri was not among us.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000150a:text","row":47052,"ordinal":60,"kind":"text","jp":"もう、いない。","en":"She isn’t here anymore.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911029","unitId":"ghs-tl:ccd4001:00060","en":"No longer... among us.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001530:text","row":47053,"ordinal":61,"kind":"text","jp":"何度繰り返そうが、霧があらわれることは永遠にない。","en":"No matter how many times this repeats, Kiri will never appear again.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911030","unitId":"ghs-tl:ccd4001:00061","en":"I can repeat this however many times, but Kiri shall not materialize, not for eternity.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000157a:text","row":47054,"ordinal":62,"kind":"text","jp":"永遠という言葉さえ矛盾に追いやって、俺と霧は繋がる術さえない。","en":"Even the word *forever* collapses into contradiction: Kiri and I have no way left to connect.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911031","unitId":"ghs-tl:ccd4001:00062","en":"But even if I were to make the word 'eternity' itself into contradiction, there are no means for me to connect with Kiri.","verdict":"confirmed_error","categories":["wrong_subject","logical_relation"],"assessment":"The lack of any way to connect makes even the word 'eternity' contradictory. The English instead makes Taichi hypothetically cause that contradiction himself.","remedy":"Even the word 'eternity' is driven into contradiction","highlights":[{"color":"red","end":72,"start":9,"text":"if I were to make the word 'eternity' itself into contradiction"}]}]},{"ref":"ccfc:sn:0339:000015d0:text","row":47055,"ordinal":63,"kind":"text","jp":"彼女たちを利用して心に糧をたくわえる俺に科せられた、当然の罰。","en":"My rightful punishment for using them to stock my heart with provisions.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911032","unitId":"ghs-tl:ccd4001:00063","en":"The just retribution for me, who exploited these girls to make provisions for his heart.","verdict":"confirmed_error","categories":["wrong_subject","grammar"],"assessment":"The first-person narrator says that he stores nourishment in his own heart. The English abruptly switches the possessive to a third-person male.","remedy":"for my heart","highlights":[{"color":"red","end":87,"start":74,"text":"for his heart"}]}]},{"ref":"ccfc:sn:0339:00001626:text","row":47056,"ordinal":64,"kind":"text","jp":"罰。","en":"My cross to bear.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911033","unitId":"ghs-tl:ccd4001:00064","en":"Retribution. Punishment. Penalty.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001642:text","row":47057,"ordinal":65,"kind":"text","jp":"×。","en":"×.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911034","unitId":"ghs-tl:ccd4001:00065","en":"Cross mark. Cross. X.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000165e:text","row":47058,"ordinal":66,"kind":"text","jp":"ＣＲＯＳＳ。","en":"CROSS.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911035","unitId":"ghs-tl:ccd4001:00066","en":"Kurosu.","verdict":"questionable","categories":["wordplay","reference_allusion"]}]},{"ref":"ccfc:sn:0339:00001682:text","row":47059,"ordinal":67,"kind":"text","jp":"けどもう、交差はできないんだ―――","en":"But our paths can never cross again—","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911036","unitId":"ghs-tl:ccd4001:00067","en":"Yet crossing is impossible, now---","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000016c4:text","row":47060,"ordinal":68,"kind":"text","jp":"「けど……どう説明する？」","en":"“Still... how am I supposed to explain it?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911037","unitId":"ghs-tl:ccd4001:00068","en":"Taichi: \"But... how do I explain this?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000016f6:text","row":47061,"ordinal":69,"kind":"text","jp":"美希に。","en":"To Miki.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911038","unitId":"ghs-tl:ccd4001:00069","en":"To Miki.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001716:text","row":47062,"ordinal":70,"kind":"text","jp":"頭が痛い。","en":"My head hurts.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911039","unitId":"ghs-tl:ccd4001:00070","en":"My head aches.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001827:text","row":47063,"ordinal":71,"kind":"text","jp":"正門に戻る。","en":"I return to the front gate.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911040","unitId":"ghs-tl:ccd4001:00071","en":"I return to the main gate.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:0000184b:text","row":47064,"ordinal":72,"kind":"text","jp":"美希は膝頭に頭を入れて、うずくまっていた。","en":"Miki is crouched there with her head buried between her knees.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:911041","unitId":"ghs-tl:ccd4001:00072","en":"Miki is squatting, head peeking over the knees.","verdict":"confirmed_error","categories":["mistranslation","logical_relation"],"assessment":"Miki is crouched with her head tucked down between or against her knees. The English depicts her head peeking over them, reversing the posture.","remedy":"her head tucked between her knees","highlights":[{"color":"red","end":46,"start":19,"text":"head peeking over the knees"}]}]},{"ref":"ccfc:sn:0339:00001895:text","row":47065,"ordinal":73,"kind":"text","jp":"「……美希、来たよ」","en":"“...Miki. I’m back.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911042","unitId":"ghs-tl:ccd4001:00073","en":"Taichi: \"...here I am, Miki!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001947:text","row":47066,"ordinal":74,"kind":"text","jp":"「…………先輩、霧が来ません」","en":"“............Taichi, Kiri isn’t coming.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911043","unitId":"ghs-tl:ccd4001:00074","en":"Miki: \"......Senpai, Kiri didn't come.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001985:text","row":47067,"ordinal":75,"kind":"text","jp":"「休みなんじゃないかなあ」","en":"“Maybe she stayed home today.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911044","unitId":"ghs-tl:ccd4001:00075","en":"Taichi: \"Well maybe she's just taking the day off or something.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:000019dc:text","row":47068,"ordinal":76,"kind":"text","jp":"「じゃあ家に……いる？」","en":"“Then... is she at home?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911045","unitId":"ghs-tl:ccd4001:00076","en":"Miki: \"Then she would be... home?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001a14:text","row":47069,"ordinal":77,"kind":"text","jp":"「さあ、どうだろう、出かけているかもしれない」","en":"“I don’t know. She might have gone out.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:911046","unitId":"ghs-tl:ccd4001:00077","en":"Taichi: \"Well, don't know, she might just have gone out or something.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001adb:text","row":47070,"ordinal":78,"kind":"text","jp":"「……行きます」","en":"“...I’m going.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:911047","unitId":"ghs-tl:ccd4001:00078","en":"Miki: \"...I'm going.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0339:00001b2b:choice:01","row":47071,"ordinal":79,"kind":"choice","jp":"デートに誘う","en":"Ask her on a date","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0339:00001b2b:choice:02","row":47072,"ordinal":80,"kind":"choice","jp":"霧の家につきあう","en":"Go with her to Kiri’s house","speakerJa":"","speakerEn":"","ghs":[]}]}

:[{"id":"ghs-tl:finding:800000","unitId":"ghs-tl:ccc0023b:00019","en":"In the garden there's a small space just for parties, I could just boil water there, but,","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000635:text","row":29173,"ordinal":20,"kind":"text","jp":"「めんでぇー（面倒だ）」","en":"“Too much wooork. (Too much trouble.)”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800001","unitId":"ghs-tl:ccc0023b:00020","en":"Taichi: \"Annooow'n. (How annoying!)\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000665:text","row":29174,"ordinal":21,"kind":"text","jp":"そのまま食うことにした。","en":"I decided to eat them as they were.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800002","unitId":"ghs-tl:ccc0023b:00021","en":"I decided to eat it as it is.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000695:text","row":29175,"ordinal":22,"kind":"text","jp":"バリバリ（麺）","en":"CRUNCH CRUNCH. (Noodles.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800003","unitId":"ghs-tl:ccc0023b:00022","en":"Scrunch, scrunch (noodles)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000006bb:text","row":29176,"ordinal":23,"kind":"text","jp":"ごくごく（水）","en":"GLUG GLUG. (Water.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800004","unitId":"ghs-tl:ccc0023b:00023","en":"Gulp, gulp (water)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000006e1:text","row":29177,"ordinal":24,"kind":"text","jp":"バリバリバリ（麺）","en":"CRUNCH CRUNCH CRUNCH. (Noodles.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800005","unitId":"ghs-tl:ccc0023b:00024","en":"Scrunch, scrunch, scrunch (noodles)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000070b:text","row":29178,"ordinal":25,"kind":"text","jp":"ごくごくごく（水）","en":"GLUG GLUG GLUG. (Water.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800006","unitId":"ghs-tl:ccc0023b:00025","en":"Gulp, gulp, gulp (water)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000735:text","row":29179,"ordinal":26,"kind":"text","jp":"バリバリバリバリ（麺）","en":"CRUNCH CRUNCH CRUNCH CRUNCH. (Noodles.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800007","unitId":"ghs-tl:ccc0023b:00026","en":"Scrunch, scrunch, scrunch, scrunch (noodles)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000763:text","row":29180,"ordinal":27,"kind":"text","jp":"サクッ……（乾燥メンマ）","en":"SNAP... (Dried bamboo shoot.)","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800008","unitId":"ghs-tl:ccc0023b:00027","en":"Cah-runch... (dried menma)","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000079b:text","row":29181,"ordinal":28,"kind":"text","jp":"「……虚しくなってきた」","en":"“...This is getting depressing.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800009","unitId":"ghs-tl:ccc0023b:00028","en":"Taichi: \"...this is just pointless.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000007cb:text","row":29182,"ordinal":29,"kind":"text","jp":"俺は本当に食事をしているのか。","en":"Was this even a meal?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800010","unitId":"ghs-tl:ccc0023b:00029","en":"Am I even having a real meal here?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000801:text","row":29183,"ordinal":30,"kind":"text","jp":"やっぱ人類滅亡きっついわ。","en":"Human extinction really sucked.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800011","unitId":"ghs-tl:ccc0023b:00030","en":"I knew it, the fall of mankind's harsh one, yes.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000833:text","row":29184,"ordinal":31,"kind":"text","jp":"いろいろ不便だもんな。","en":"It made everything such a pain.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800012","unitId":"ghs-tl:ccc0023b:00031","en":"Lots and lots of inconveniences around.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000009e1:text","row":29185,"ordinal":32,"kind":"text","jp":"蝋燭に火をつける。","en":"I lit a candle.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800013","unitId":"ghs-tl:ccc0023b:00032","en":"I ignite a candle.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000a0b:text","row":29186,"ordinal":33,"kind":"text","jp":"日記をつけることにした。","en":"I decided to keep a diary.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800014","unitId":"ghs-tl:ccc0023b:00033","en":"I had decided to keep a diary.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000a3b:text","row":29187,"ordinal":34,"kind":"text","jp":"なんかヘミングウェイっぽいし。","en":"Kind of Hemingway of me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800015","unitId":"ghs-tl:ccc0023b:00034","en":"Sorta Hemingwayish.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000a71:text","row":29188,"ordinal":35,"kind":"text","jp":"日記に使おうと大学ノートを探すが、どこにもなかった。","en":"I looked everywhere for one of the ruled notebooks I’d bought for the diary, but couldn’t find any.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800016","unitId":"ghs-tl:ccc0023b:00035","en":"I search for a college notebook to use as diary, but there were none anywhere.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000ac5:text","row":29189,"ordinal":36,"kind":"text","jp":"「ん？」","en":"“Hm?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800017","unitId":"ghs-tl:ccc0023b:00036","en":"Taichi: \"Hm?\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000ae5:text","row":29190,"ordinal":37,"kind":"text","jp":"確か何冊か買い置きがあったのに。","en":"I could have sworn I’d stocked up on a few.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800018","unitId":"ghs-tl:ccc0023b:00037","en":"But I was sure there I had so many stocked up.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000b25:text","row":29191,"ordinal":38,"kind":"text","jp":"「んー」","en":"“Hmm.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800019","unitId":"ghs-tl:ccc0023b:00038","en":"Taichi: \"Hmmm.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000b45:text","row":29192,"ordinal":39,"kind":"text","jp":"金庫の中か。","en":"Maybe they were in the safe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800020","unitId":"ghs-tl:ccc0023b:00039","en":"Inside the safe?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000b69:text","row":29193,"ordinal":40,"kind":"text","jp":"一応調べてみる。","en":"Worth a look.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800021","unitId":"ghs-tl:ccc0023b:00040","en":"Just in case I'll try to investigate.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000b91:text","row":29194,"ordinal":41,"kind":"text","jp":"金庫には、基本的にエロ本を収納してある。","en":"The safe was used primarily to store porn.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800022","unitId":"ghs-tl:ccc0023b:00041","en":"My safe is fundamentally a storehouse for porn books.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000bd1:text","row":29195,"ordinal":42,"kind":"text","jp":"耐火金庫なので、家事になっても俺のエロスは保たれるって寸法さ。","en":"It was fireproof, so even if the house burned down, my erotic legacy would live on.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800023","unitId":"ghs-tl:ccc0023b:00042","en":"This being a fireproof safe, so regardless of housework my Eros will be safeguarded.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000c27:text","row":29196,"ordinal":43,"kind":"text","jp":"調べるため、金庫をあけた。","en":"I opened it to check.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800024","unitId":"ghs-tl:ccc0023b:00043","en":"For purposes of investigation, I opened the safe.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000cf4:text","row":29197,"ordinal":44,"kind":"text","jp":"……………………。","en":"........................","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800025","unitId":"ghs-tl:ccc0023b:00044","en":"............","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000e08:text","row":29198,"ordinal":45,"kind":"text","jp":"三十分後、金庫を閉じた。","en":"Thirty minutes later, I closed the safe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800026","unitId":"ghs-tl:ccc0023b:00045","en":"Thirty minutes later, I shut the safe.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000e38:text","row":29199,"ordinal":46,"kind":"text","jp":"ここにノートはなかった。","en":"No notebook.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800027","unitId":"ghs-tl:ccc0023b:00046","en":"There were no notebooks here.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000e70:text","row":29200,"ordinal":47,"kind":"text","jp":"「ふぅ」","en":"“Whew.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800028","unitId":"ghs-tl:ccc0023b:00047","en":"Taichi: \"Whew.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000e90:text","row":29201,"ordinal":48,"kind":"text","jp":"いかん、無駄に時間をロスしてしまった。","en":"Crap. I’d just wasted all that time for nothing.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800029","unitId":"ghs-tl:ccc0023b:00048","en":"This is bad, I lost a lot of time pointlessly dammit.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000ece:text","row":29202,"ordinal":49,"kind":"text","jp":"まったくもう……この金庫の中身と来たら……フフフ。","en":"Honestly, the things in that safe... Heh heh heh.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800030","unitId":"ghs-tl:ccc0023b:00049","en":"Seriously, though... when it comes to the contents of the safe... hoh hoh hoh!","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000f18:text","row":29203,"ordinal":50,"kind":"text","jp":"罪深い桃色小空間め。","en":"You sinful little pink pleasure palace.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800031","unitId":"ghs-tl:ccc0023b:00050","en":"Damn that sinful, tiny peach-pink space.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000f44:text","row":29204,"ordinal":51,"kind":"text","jp":"さて、ノートはどこに行ったのだろう。心当たりがない。","en":"So where had the notebooks gone? I didn’t have a clue.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800032","unitId":"ghs-tl:ccc0023b:00051","en":"So then, where did those notebooks go then. I have no clue.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000f90:text","row":29205,"ordinal":52,"kind":"text","jp":"記憶喪失か。","en":"Was I losing my memory?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800033","unitId":"ghs-tl:ccc0023b:00052","en":"Memory loss?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00000fbc:text","row":29206,"ordinal":53,"kind":"text","jp":"「いよいよ俺も主人公っぷりに磨きがかかってきたようだ……あ、そだ」","en":"“At this rate, I’m turning into more of a protagonist by the minute... Oh, right.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800034","unitId":"ghs-tl:ccc0023b:00053","en":"Taichi: \"More and more I seem to improve and polish my Heroic Protagonist characteristics... ah, right.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001016:text","row":29207,"ordinal":54,"kind":"text","jp":"曜子ちゃんにもらったノート。","en":"The notebook Youko gave me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800035","unitId":"ghs-tl:ccc0023b:00054","en":"The notebooks Youko-chan brought me.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000104a:text","row":29208,"ordinal":55,"kind":"text","jp":"ベストタイミングだ。","en":"Perfect timing.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800036","unitId":"ghs-tl:ccc0023b:00055","en":"That's the Best of Timings.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001076:text","row":29209,"ordinal":56,"kind":"text","jp":"……なんか神がかってるな、彼女。","en":"...Her timing was almost supernatural.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800037","unitId":"ghs-tl:ccc0023b:00056","en":"...she's really divinely inspired, isn't she.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000010ae:text","row":29210,"ordinal":57,"kind":"text","jp":"シュリンクをペリペリはがす。","en":"I peeled away the shrink-wrap.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800038","unitId":"ghs-tl:ccc0023b:00057","en":"Crinkle-crinkle I peel the shrinkwrap.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000010e2:text","row":29211,"ordinal":58,"kind":"text","jp":"さて、書くか。","en":"Time to write.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800039","unitId":"ghs-tl:ccc0023b:00058","en":"So then, to write?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001110:text","row":29212,"ordinal":59,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800040","unitId":"ghs-tl:ccc0023b:00059","en":"Taichi: \"...\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001130:text","row":29213,"ordinal":60,"kind":"text","jp":"ペンがないぞ。","en":"No pen.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800041","unitId":"ghs-tl:ccc0023b:00060","en":"Don't got pen.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001156:text","row":29214,"ordinal":61,"kind":"text","jp":"見あたらない。","en":"None in sight.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800042","unitId":"ghs-tl:ccc0023b:00061","en":"It's nowhere in sight.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001184:text","row":29215,"ordinal":62,"kind":"text","jp":"「金庫の中か？」","en":"“In the safe?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800043","unitId":"ghs-tl:ccc0023b:00062","en":"Taichi: \"Inside the safe?\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000011ac:text","row":29216,"ordinal":63,"kind":"text","jp":"再び金庫をあける。ペンを探すために。","en":"I opened the safe again—strictly to look for a pen.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800044","unitId":"ghs-tl:ccc0023b:00063","en":"I open the safe once again, for the purpose of searching for a pen.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001283:text","row":29217,"ordinal":64,"kind":"text","jp":"……………………。","en":"........................","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800045","unitId":"ghs-tl:ccc0023b:00064","en":"............","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001397:text","row":29218,"ordinal":65,"kind":"text","jp":"四十五分後、金庫を閉じた。","en":"Forty-five minutes later, I closed the safe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800046","unitId":"ghs-tl:ccc0023b:00065","en":"Forty-five minutes later, I shut the safe.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000013c9:text","row":29219,"ordinal":66,"kind":"text","jp":"ペンはなかった。","en":"No pen.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800047","unitId":"ghs-tl:ccc0023b:00066","en":"A pen there was not.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000013f1:text","row":29220,"ordinal":67,"kind":"text","jp":"愛があった。","en":"There was love.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800048","unitId":"ghs-tl:ccc0023b:00067","en":"Love there was.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000141d:text","row":29221,"ordinal":68,"kind":"text","jp":"「……ふぅぅ～」","en":"“...Wheeeeeew.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800049","unitId":"ghs-tl:ccc0023b:00068","en":"Taichi: \"...Wheee～w.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001445:text","row":29222,"ordinal":69,"kind":"text","jp":"せっかく急いだのに、連戦しちゃあ意味がないよね♪","en":"What was the point of rushing when I went straight into round two? ♪","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800050","unitId":"ghs-tl:ccc0023b:00069","en":"Though I made effort to hurry, this series of battles is meaningless oh yes.♪","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000148d:text","row":29223,"ordinal":70,"kind":"text","jp":"小憎らしい誘惑夢小箱め！","en":"You wicked little box of wet dreams!","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800051","unitId":"ghs-tl:ccc0023b:00070","en":"Curse that inveigling little dream box of allurement!","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000014bd:text","row":29224,"ordinal":71,"kind":"text","jp":"ペンは机の横に落ちていた。","en":"The pen was lying beside the desk.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800052","unitId":"ghs-tl:ccc0023b:00071","en":"The pen had fallen off the side of the desk.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000014ef:text","row":29225,"ordinal":72,"kind":"text","jp":"日記を書く。","en":"I started writing.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800053","unitId":"ghs-tl:ccc0023b:00072","en":"I write the diary.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001513:text","row":29226,"ordinal":73,"kind":"text","jp":"辞書が欲しくなった。","en":"Then I wanted a dictionary.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800054","unitId":"ghs-tl:ccc0023b:00073","en":"I ended up needing a dictionary.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000153f:text","row":29227,"ordinal":74,"kind":"text","jp":"ところが辞書がないのだ。","en":"But there wasn’t one.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800055","unitId":"ghs-tl:ccc0023b:00074","en":"But fact is, there is no dictionary.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001577:text","row":29228,"ordinal":75,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800056","unitId":"ghs-tl:ccc0023b:00075","en":"Taichi: \"...\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001597:text","row":29229,"ordinal":76,"kind":"text","jp":"金庫をあける。","en":"I opened the safe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800057","unitId":"ghs-tl:ccc0023b:00076","en":"I open the safe.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001658:text","row":29230,"ordinal":77,"kind":"text","jp":"……………………。","en":"........................","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800058","unitId":"ghs-tl:ccc0023b:00077","en":"............","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000176c:text","row":29231,"ordinal":78,"kind":"text","jp":"一時間二十七分後、金庫を閉じた。","en":"One hour and twenty-seven minutes later, I closed the safe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800059","unitId":"ghs-tl:ccc0023b:00078","en":"One hour and twenty-seven minutes later,","verdict":"confirmed_error","categories":["omission"],"assessment":"The Japanese states that the safe is then closed; the English supplies only the elapsed-time phrase and omits the action.","remedy":"","highlights":[{"color":"red","end":40,"start":0,"text":"One hour and twenty-seven minutes later,"}]}]},{"ref":"ccfc:sn:0195:000017ac:text","row":29232,"ordinal":79,"kind":"text","jp":"「……ふ」","en":"“...Whew.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800060","unitId":"ghs-tl:ccc0023b:00079","en":"Taichi: \"...whew.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000017ce:text","row":29233,"ordinal":80,"kind":"text","jp":"ハッスルしすぎ、俺。","en":"I’d gone way too hard.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800061","unitId":"ghs-tl:ccc0023b:00080","en":"I got too much hustle on, I do.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000017fa:text","row":29234,"ordinal":81,"kind":"text","jp":"究極抱き枕（商品名）は、どうも具合が良すぎてイカン。","en":"The Ultimate Body Pillow™ worked far too well for its own good.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800062","unitId":"ghs-tl:ccc0023b:00081","en":"The Ultimate Dakimakura (product name) felt for some reason excessively good and cut it out.","verdict":"confirmed_error","categories":["mistranslation","grammar"],"assessment":"The Japanese says the product works or feels too good and that this itself is a problem; the highlighted clause introduces an unsupported command.","remedy":"","highlights":[{"color":"red","end":91,"start":77,"text":"and cut it out"}]}]},{"ref":"ccfc:sn:0195:00001846:text","row":29235,"ordinal":82,"kind":"text","jp":"もう十時を過ぎていた。","en":"It was past ten already.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800063","unitId":"ghs-tl:ccc0023b:00082","en":"It was already past ten o'clock.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:0000187c:text","row":29236,"ordinal":83,"kind":"text","jp":"「うおっ！？」","en":"“What!?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800064","unitId":"ghs-tl:ccc0023b:00083","en":"Taichi: \"Whoa?!\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:000018a2:text","row":29237,"ordinal":84,"kind":"text","jp":"特大の蝋燭もとうに消えていた。","en":"Even the enormous candle had gone out ages ago.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800065","unitId":"ghs-tl:ccc0023b:00084","en":"The extra-large candle had already disappeared.","verdict":"confirmed_error","categories":["word_choice"],"assessment":"The Japanese says the candle flame had gone out, not that it had disappeared.","remedy":"","highlights":[{"color":"red","end":46,"start":35,"text":"disappeared"}]}]},{"ref":"ccfc:sn:0195:000018d8:text","row":29238,"ordinal":85,"kind":"text","jp":"しまった、虚脱に時間を割きすぎた。","en":"Damn. I’d spent way too long in a post-orgasm haze.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800066","unitId":"ghs-tl:ccc0023b:00085","en":"Dammit, I spent too much time in despondency.","verdict":"confirmed_error","categories":["word_choice"],"assessment":"The Japanese denotes physical or mental enervation; the highlighted word instead specifies dejection.","remedy":"","highlights":[{"color":"red","end":44,"start":33,"text":"despondency"}]}]},{"ref":"ccfc:sn:0195:00001912:text","row":29239,"ordinal":86,"kind":"text","jp":"だから抱き枕系のジョークグッズは……。","en":"And this was why novelty body pillows were dangerous...","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800067","unitId":"ghs-tl:ccc0023b:00086","en":"Therefore, these novelty items of a Dakimakura fan...","verdict":"confirmed_error","categories":["addition","word_choice"],"assessment":"The Japanese classifies a type of body pillow; it does not call the referent a fan of body pillows.","remedy":"","highlights":[{"color":"red","end":50,"start":36,"text":"Dakimakura fan"}]}]},{"ref":"ccfc:sn:0195:00001950:text","row":29240,"ordinal":87,"kind":"text","jp":"と、日記を書かねば。","en":"Oh, right. The diary.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800068","unitId":"ghs-tl:ccc0023b:00087","en":"But if I don't write the diary...","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0195:00001a4d:text","row":29241,"ordinal":88,"kind":"text","jp":"新しい蝋燭をつけて、ノートに立ち向かう。","en":"I lit a fresh candle and squared off against the notebook.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800069","unitId":"ghs-tl:ccc0023b:00088","en":"I light up a new candle, and square off with the notebook.","verdict":"acceptable","categories":["presentation"]}]}]}

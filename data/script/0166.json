{"schema":"mao-cross-channel-public-site-data/1","script":"0166","rows":[{"ref":"ccfc:sn:0166:00000039:text","row":27321,"ordinal":1,"kind":"text","jp":"「誰かこれぞってカワイコちゃんと食わせてもらうよ」","en":"“I’ll find one seriously cute girl and eat them with her.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:010710","unitId":"ghs-tl:ccc0004b:00001","en":"Taichi: \"I'll be eating these with some cute Kawaiiko-chan then.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0166:000000a8:text","row":27322,"ordinal":2,"kind":"text","jp":"「……………………」","en":"“................”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[{"id":"ghs-tl:finding:010711","unitId":"ghs-tl:ccc0004b:00002","en":"Youko: \"............\"","verdict":"acceptable","categories":["name_address"]}]},{"ref":"ccfc:sn:0166:000000d4:text","row":27323,"ordinal":3,"kind":"text","jp":"ぴく、とあからさまに頬が引きつった。","en":"Her cheek gave an unmistakable twitch.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:010712","unitId":"ghs-tl:ccc0004b:00003","en":"Ping, and the cheeks stiffened, unabashed.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0166:00000110:text","row":27324,"ordinal":4,"kind":"text","jp":"こころなしか恨みがましい目つき。","en":"Her eyes looked just a little resentful.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:010713","unitId":"ghs-tl:ccc0004b:00004","en":"A somewhat resentful look in her eyes.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0166:00000150:text","row":27325,"ordinal":5,"kind":"text","jp":"「なにか問題でもありますか？」","en":"“Is there a problem?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:010714","unitId":"ghs-tl:ccc0004b:00005","en":"Taichi: \"Could there be any problem with this?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0166:0000020c:text","row":27326,"ordinal":6,"kind":"text","jp":"「……ないわ」","en":"“...No.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[{"id":"ghs-tl:finding:010715","unitId":"ghs-tl:ccc0004b:00006","en":"Youko: \"...none, no.\"","verdict":"acceptable","categories":["name_address"]}]},{"ref":"ccfc:sn:0166:0000023a:text","row":27327,"ordinal":7,"kind":"text","jp":"「そりゃ結構」","en":"“Excellent.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:010716","unitId":"ghs-tl:ccc0004b:00007","en":"Taichi: \"That's splendid.\"","verdict":"acceptable","categories":["word_choice"]}]}]}

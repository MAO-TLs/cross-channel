{"schema":"mao-cross-channel-public-site-data/1","script":"0257","rows":[{"ref":"ccfc:sn:0257:000000f5:text","row":35236,"ordinal":1,"kind":"text","jp":"「どもー」","en":"“Hey.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900000","unitId":"ghs-tl:ccc3028:00001","en":"Taichi: \"Hellooo!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000001d4:text","row":35237,"ordinal":2,"kind":"text","jp":"「……お、おせえ～」","en":"“...Y-you’re laaate.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900001","unitId":"ghs-tl:ccc3028:00002","en":"Miki: \"...l-, layyy～te\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000200:text","row":35238,"ordinal":3,"kind":"text","jp":"屋上に戻った。","en":"I returned to the roof.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900002","unitId":"ghs-tl:ccc3028:00003","en":"We returned to the rooftop.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000002ac:text","row":35239,"ordinal":4,"kind":"text","jp":"「あ、霧ちんは連れてきたですね」","en":"“Oh, you brought Kiri-kins after all.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900003","unitId":"ghs-tl:ccc3028:00004","en":"Miki: \"Ah, you brought Kiri-chin with you!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000002ec:text","row":35240,"ordinal":5,"kind":"text","jp":"「きたともさ」","en":"“That I did.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900004","unitId":"ghs-tl:ccc3028:00005","en":"Taichi: \"We came oh yes.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000398:text","row":35241,"ordinal":6,"kind":"text","jp":"「なにやら……つやつやしているような……」","en":"“She seems... strangely radiant.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900005","unitId":"ghs-tl:ccc3028:00006","en":"Misato: \"Somehow... you're looking all glossy and slick...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000003e2:text","row":35242,"ordinal":7,"kind":"text","jp":"「つやつやですさ」","en":"“Radiant indeed.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900006","unitId":"ghs-tl:ccc3028:00007","en":"Taichi: \"We are slick and we are glossy, yes.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000492:text","row":35243,"ordinal":8,"kind":"text","jp":"「……どうしたの、霧ちん？」","en":"“...What happened, Kiri-kins?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900007","unitId":"ghs-tl:ccc3028:00008","en":"Miki: \"...what is it, Kiri-chin?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000005a0:text","row":35244,"ordinal":9,"kind":"text","jp":"「え、ううん、なんでもない……」","en":"“Huh? No, it's nothing...”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900008","unitId":"ghs-tl:ccc3028:00009","en":"Kiri: \"Eh, naah, nothing really...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000005fd:text","row":35245,"ordinal":10,"kind":"text","jp":"「生理終わったんでしょ？」","en":"“Your period ended, didn’t it?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900009","unitId":"ghs-tl:ccc3028:00010","en":"Miki: \"Your things are over aren't they?\"","verdict":"questionable","categories":["undertranslation","word_choice"]}]},{"ref":"ccfc:sn:0257:000006b3:text","row":35246,"ordinal":11,"kind":"text","jp":"「お、終わったけど……」","en":"“I-it did, but...”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900010","unitId":"ghs-tl:ccc3028:00011","en":"Kiri: \"O-, over, but...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000006e3:text","row":35247,"ordinal":12,"kind":"text","jp":"もじもじと脚をすりあわせる。","en":"She fidgeted, rubbing her thighs together.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900011","unitId":"ghs-tl:ccc3028:00012","en":"Fidget-fidget she rubs her legs together.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000008f7:text","row":35248,"ordinal":13,"kind":"text","jp":"「……顔色が優れませんね、平気ですか？」","en":"“...You’re pale. Are you all right?”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900012","unitId":"ghs-tl:ccc3028:00013","en":"Misato: \"...the color of your face is less than full, are you alright?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000095a:text","row":35249,"ordinal":14,"kind":"text","jp":"「平気です。ちょっと、疲れが……夏ばてして」","en":"“I'm fine. Just a little tired... Must be the heat.”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900013","unitId":"ghs-tl:ccc3028:00014","en":"Kiri: \"I am alright. Just a bit tired... Summer fatigue.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000009a6:text","row":35250,"ordinal":15,"kind":"text","jp":"「それはいかん。夏バテ解消には俺特製白汁を飲まないとだめだ」","en":"“That won't do. Summer fatigue means you need a dose of my special white juice.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900014","unitId":"ghs-tl:ccc3028:00015","en":"Taichi: \"That's way bad. You'll just have to liquidate your Summer fatigue by drinking my Special Brew White Juice!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000009fa:text","row":35251,"ordinal":16,"kind":"text","jp":"水筒を取り出す。","en":"I produced a thermos.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900015","unitId":"ghs-tl:ccc3028:00016","en":"I take out the canteen.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000aa8:text","row":35252,"ordinal":17,"kind":"text","jp":"「ありがとうございます、ぺけくん」","en":"“Thank you, Peke.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900016","unitId":"ghs-tl:ccc3028:00017","en":"Misato: \"Thank you very much, Peke-kun.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000ae2:text","row":35253,"ordinal":18,"kind":"text","jp":"水筒を受け取る。","en":"Misato accepted it.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900017","unitId":"ghs-tl:ccc3028:00018","en":"She accepts the canteen.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000b0a:text","row":35254,"ordinal":19,"kind":"text","jp":"この特製白汁は一見したところただの乳酸製品だが、隠し味に素敵な成分が入っているのである。","en":"At a glance, my special white juice looked like an ordinary cultured-milk drink. But it had a lovely secret ingredient.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900018","unitId":"ghs-tl:ccc3028:00019","en":"This Special Brew White Juice is, on first sight, a normal brew of lactic acids; however, a splendid ingredient is sprinkled in to bring out its flavor.","verdict":"questionable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000c56:text","row":35255,"ordinal":20,"kind":"text","jp":"「しろじる？」","en":"“White juice?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900019","unitId":"ghs-tl:ccc3028:00020","en":"Miki: \"White juice?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000d02:text","row":35256,"ordinal":21,"kind":"text","jp":"「あ、あれはなんでしょう？」","en":"“Oh! What could that be?”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900020","unitId":"ghs-tl:ccc3028:00021","en":"Misato: \"Ah-, what is that thing?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000dea:text","row":35257,"ordinal":22,"kind":"text","jp":"「えっ？」","en":"“What?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900021","unitId":"ghs-tl:ccc3028:00022","en":"Taichi: \"Eh?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000e0c:text","row":35258,"ordinal":23,"kind":"text","jp":"空を見る。","en":"I looked up.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900022","unitId":"ghs-tl:ccc3028:00023","en":"I look at the sky.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00000e2e:text","row":35259,"ordinal":24,"kind":"text","jp":"なんだＵＦＯか？　アダムスキーか。","en":"A UFO? An Adamski saucer?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900023","unitId":"ghs-tl:ccc3028:00024","en":"Could it be a UFO? Where's Adamski?","verdict":"confirmed_error","categories":["mistranslation","word_choice"],"assessment":"The Japanese asks whether the object is an Adamski-type flying saucer. It does not ask for the location of a person named Adamski.","remedy":"Could it be a UFO? An Adamski type?","highlights":[{"color":"red","end":35,"start":19,"text":"Where's Adamski?"}]}]},{"ref":"ccfc:sn:0257:00000e8d:text","row":35260,"ordinal":25,"kind":"text","jp":"「…………どぼどぼどぼどぼ」","en":"“............Glug glug glug glug.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900024","unitId":"ghs-tl:ccc3028:00025","en":"Misato: \"......glug-glug-glug-glug!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001046:text","row":35261,"ordinal":26,"kind":"text","jp":"「なにもありませんよ？」","en":"“I don’t see anything.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900025","unitId":"ghs-tl:ccc3028:00026","en":"Taichi: \"But there is nothing there?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000010fc:text","row":35262,"ordinal":27,"kind":"text","jp":"「ふう、ごちそうさまでした！」","en":"“Whew—thanks for the drink!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900026","unitId":"ghs-tl:ccc3028:00027","en":"Misato: \"Whew, thank you very much for this!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001132:text","row":35263,"ordinal":28,"kind":"text","jp":"カラの水筒を返された。","en":"She handed back an empty thermos.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900027","unitId":"ghs-tl:ccc3028:00028","en":"She returns an empty canteen.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001168:text","row":35264,"ordinal":29,"kind":"text","jp":"「……もう飲まれましたか」","en":"“...You finished it already?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900028","unitId":"ghs-tl:ccc3028:00029","en":"Taichi: \"...aw, you drank it all.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001220:text","row":35265,"ordinal":30,"kind":"text","jp":"「ええ、三人でわけてたっぷりと」","en":"“Yes. The three of us shared it—quite generously.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900029","unitId":"ghs-tl:ccc3028:00030","en":"Misato: \"Yes, we divided it among us all three.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000012de:text","row":35266,"ordinal":31,"kind":"text","jp":"「……え？　いつ？」","en":"“...What? When?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900030","unitId":"ghs-tl:ccc3028:00031","en":"Miki: \"...eh? When?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001312:text","row":35267,"ordinal":32,"kind":"text","jp":"「はははは」","en":"“Hahahaha.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900031","unitId":"ghs-tl:ccc3028:00032","en":"Taichi: \"Hahahahah.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000013bc:text","row":35268,"ordinal":33,"kind":"text","jp":"「ふふふふ」","en":"“Heh heh heh.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900032","unitId":"ghs-tl:ccc3028:00033","en":"Misato: \"Heheheheh.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000013e8:text","row":35269,"ordinal":34,"kind":"text","jp":"「あはははははは」","en":"“Ahahahahahaha.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900033","unitId":"ghs-tl:ccc3028:00034","en":"Taichi: \"Ahhhahahahahah.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001498:text","row":35270,"ordinal":35,"kind":"text","jp":"「ふふふふふふふ」","en":"“Heh heh heh heh heh.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900034","unitId":"ghs-tl:ccc3028:00035","en":"Misato: \"Hehehehehe.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000014c2:text","row":35271,"ordinal":36,"kind":"text","jp":"よかったよかった。","en":"Good, good.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900035","unitId":"ghs-tl:ccc3028:00036","en":"It's all good, it's all good.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001572:text","row":35272,"ordinal":37,"kind":"text","jp":"「あの……わたしには捨ててたように見え……」","en":"“Um... It looked more like you dumped it—”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900036","unitId":"ghs-tl:ccc3028:00037","en":"Miki: \"Uhm... it looked like you just tossed it away to mYAN---\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001617:text","row":35273,"ordinal":38,"kind":"text","jp":"みみ先輩は美希を抱きしめた。","en":"Mimi caught Miki in a crushing hug.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900037","unitId":"ghs-tl:ccc3028:00038","en":"Mimi-senpai embraced Miki.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000016d1:text","row":35274,"ordinal":39,"kind":"text","jp":"「むぐぐぐぐっ！」","en":"“Mmmghghgh!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900038","unitId":"ghs-tl:ccc3028:00039","en":"Miki: \"MGuHGuHGuHGuH!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000016fb:text","row":35275,"ordinal":40,"kind":"text","jp":"美乳固めだ。","en":"The Perfect-Tit Press.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900039","unitId":"ghs-tl:ccc3028:00040","en":"Big Beautiful Breasts Clampdown.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001727:text","row":35276,"ordinal":41,"kind":"text","jp":"「……捨てた？」","en":"“...Poured it out?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900040","unitId":"ghs-tl:ccc3028:00041","en":"Taichi: \"...tossed?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000017d5:text","row":35277,"ordinal":42,"kind":"text","jp":"「さあ、見て下さいな！　だいぶ準備が整いましたよ！」","en":"“Now, look! We're nearly ready!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900041","unitId":"ghs-tl:ccc3028:00042","en":"Misato: \"Say, look here please! Most of the preparations are in order!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001906:text","row":35278,"ordinal":43,"kind":"text","jp":"連れて行かれる。","en":"I was led away.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900042","unitId":"ghs-tl:ccc3028:00043","en":"I was taken and brought with.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001936:text","row":35279,"ordinal":44,"kind":"text","jp":"「は、はあ？」","en":"“H-huh?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900043","unitId":"ghs-tl:ccc3028:00044","en":"Taichi: \"H-, huh?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001981:text","row":35280,"ordinal":45,"kind":"text","jp":"「霧ちんさあ」","en":"“Kiri-kins.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900044","unitId":"ghs-tl:ccc3028:00045","en":"Miki: \"Kiri-chin, say.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000019ca:text","row":35281,"ordinal":46,"kind":"text","jp":"「うん、なに？」","en":"“Yes? What?”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900045","unitId":"ghs-tl:ccc3028:00046","en":"Kiri: \"Yes, what?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001a17:text","row":35282,"ordinal":47,"kind":"text","jp":"「……なんでもない」","en":"“...Never mind.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900046","unitId":"ghs-tl:ccc3028:00047","en":"Miki: \"...it's nothing.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001a66:text","row":35283,"ordinal":48,"kind":"text","jp":"「？」","en":"“?”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900047","unitId":"ghs-tl:ccc3028:00048","en":"Kiri: \"?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001a84:text","row":35284,"ordinal":49,"kind":"text","jp":"背後の会話。","en":"Their voices drifted after me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900048","unitId":"ghs-tl:ccc3028:00049","en":"A conversation at my back.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001aa8:text","row":35285,"ordinal":50,"kind":"text","jp":"少し気にはなったが、意識はたちまちテントに向いた。","en":"I wondered about it, but the tent seized my attention a moment later.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900049","unitId":"ghs-tl:ccc3028:00050","en":"I was a bit concerned, but my awareness was all at once directed towards the tent.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001afa:text","row":35286,"ordinal":51,"kind":"text","jp":"「あ、らばー」","en":"“Oh, Sakurabae.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900050","unitId":"ghs-tl:ccc3028:00051","en":"Taichi: \"Ah, Saaack!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001ba6:text","row":35287,"ordinal":52,"kind":"text","jp":"「ラバー。つまり恋人のことだ」","en":"“Bae. As in sweetheart.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900051","unitId":"ghs-tl:ccc3028:00052","en":"Sakuraba: \"-Raba. In other words, the rest of me is a lover.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001bdc:text","row":35288,"ordinal":53,"kind":"text","jp":"桜庭はテントの下にいた。","en":"Sakuraba stood beneath the tent.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900052","unitId":"ghs-tl:ccc3028:00053","en":"Sakuraba was under the tent.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001c14:text","row":35289,"ordinal":54,"kind":"text","jp":"「友貴は？」","en":"“Where’s Tomoki?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900053","unitId":"ghs-tl:ccc3028:00054","en":"Taichi: \"And Tomoki?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001c5d:text","row":35290,"ordinal":55,"kind":"text","jp":"「シスコンがこうじて帰宅した」","en":"“His sister complex got the better of him. He went home.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900054","unitId":"ghs-tl:ccc3028:00055","en":"Sakuraba: \"Siscon grew troubled and went home.\"","verdict":"confirmed_error","categories":["mistranslation","wrong_subject","logical_relation"],"assessment":"The Japanese says Tomoki's sister complex intensified or got the better of him, causing him to go home. The English turns 'siscon' into an entity that became troubled and loses the causal sense.","remedy":"His sister complex got the better of him, so he went home.","highlights":[{"color":"red","end":31,"start":11,"text":"Siscon grew troubled"}]}]},{"ref":"ccfc:sn:0257:00001c9b:text","row":35291,"ordinal":56,"kind":"text","jp":"「……さうか」","en":"“...So it be.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900055","unitId":"ghs-tl:ccc3028:00056","en":"Taichi: \"...right.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001d47:text","row":35292,"ordinal":57,"kind":"text","jp":"「配線だけは整えていった。ヤツは仕事人だ」","en":"“He did finish the wiring first. The man's a professional.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900056","unitId":"ghs-tl:ccc3028:00057","en":"Sakuraba: \"He just got the wiring in order. Guy's a working man.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001d91:text","row":35293,"ordinal":58,"kind":"text","jp":"「うむ」","en":"“Indeed.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900057","unitId":"ghs-tl:ccc3028:00058","en":"Taichi: \"Mh-hm.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001db1:text","row":35294,"ordinal":59,"kind":"text","jp":"ま、ここまできたらもう心配はいらないか。","en":"At this point, there probably wasn't anything left to worry about.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900058","unitId":"ghs-tl:ccc3028:00059","en":"Well, if we got this far we shouldn't need to worry.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001e77:text","row":35295,"ordinal":60,"kind":"text","jp":"「休憩しましょうか。喉も渇きましたし」","en":"“Shall we take a break? I’m thirsty.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900059","unitId":"ghs-tl:ccc3028:00060","en":"Misato: \"Let's take a break then. My throat is parched.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001eb5:text","row":35296,"ordinal":61,"kind":"text","jp":"先輩が小型冷蔵庫からお茶缶を取り出す。","en":"Misato took cans of tea from a small refrigerator.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900060","unitId":"ghs-tl:ccc3028:00061","en":"Senpai produces cans of tea from a small refrigerator.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001efb:text","row":35297,"ordinal":62,"kind":"text","jp":"「……え？　喉が乾いたって？」","en":"“...What? You’re thirsty?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900061","unitId":"ghs-tl:ccc3028:00062","en":"Taichi: \"...eh? Did you say you're thirsty?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00001fb7:text","row":35298,"ordinal":63,"kind":"text","jp":"「ほら、あまったバッテリーで文明の利器が復活です」","en":"“Look. A spare battery has revived one of civilization's great achievements.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900062","unitId":"ghs-tl:ccc3028:00063","en":"Misato: \"Look, with extra batteries we have resurrected the conveniences of civilization!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002001:text","row":35299,"ordinal":64,"kind":"text","jp":"部室にあるものより小型の冷蔵庫だった。","en":"The refrigerator was smaller than the one in the clubroom.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900063","unitId":"ghs-tl:ccc3028:00064","en":"It was a refrigerator even smaller than the one in the club room.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002047:text","row":35300,"ordinal":65,"kind":"text","jp":"「へー」","en":"“Huh.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900064","unitId":"ghs-tl:ccc3028:00065","en":"Taichi: \"Ehhh.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002067:text","row":35301,"ordinal":66,"kind":"text","jp":"友貴だな。","en":"Tomoki’s work, surely.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900065","unitId":"ghs-tl:ccc3028:00066","en":"From Tomoki, innit.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000020ae:text","row":35302,"ordinal":67,"kind":"text","jp":"「久しぶりに冷たいのみものですー！」","en":"“Cold drinks! After all this time!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900066","unitId":"ghs-tl:ccc3028:00067","en":"Misato: \"It has been so long since the last cold drink!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002170:text","row":35303,"ordinal":68,"kind":"text","jp":"「はい、あなたの分ですよ」","en":"“Here. This one is yours.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900067","unitId":"ghs-tl:ccc3028:00068","en":"Misato: \"Here, this is for you.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000021aa:text","row":35304,"ordinal":69,"kind":"text","jp":"「それはいいんですけど……先輩さっき俺の白汁……」","en":"“Fine, but... what about the white juice I just gave you?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900068","unitId":"ghs-tl:ccc3028:00069","en":"Taichi: \"This is fine, however... Senpai, my White Juice, before...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000227a:text","row":35305,"ordinal":70,"kind":"text","jp":"「かんぱーい！」","en":"“Cheers!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900069","unitId":"ghs-tl:ccc3028:00070","en":"Misato: \"Bottoms uuup!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000022aa:text","row":35306,"ordinal":71,"kind":"text","jp":"「は、はあ、かんぱい……です」","en":"“Uh... sure. Cheers.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900070","unitId":"ghs-tl:ccc3028:00071","en":"Taichi: \"Ah, uh, bottoms up... of course.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000022e0:text","row":35307,"ordinal":72,"kind":"text","jp":"足りなかったのかな、白汁。","en":"Maybe there hadn't been enough white juice.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900071","unitId":"ghs-tl:ccc3028:00072","en":"Maybe that White Juice just wasn't enough.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002312:text","row":35308,"ordinal":73,"kind":"text","jp":"乳酸飲料にレモン汁をまぜた特製ドリンクなのに……。","en":"Even though it was my special cultured-milk-and-lemon drink...","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900072","unitId":"ghs-tl:ccc3028:00073","en":"And it was a Special Brew of a lactic acid drink mixed with lemon juice...","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000235c:text","row":35309,"ordinal":74,"kind":"text","jp":"まあ、いい。","en":"Well, never mind.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900073","unitId":"ghs-tl:ccc3028:00074","en":"Ah, whatever.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002380:text","row":35310,"ordinal":75,"kind":"text","jp":"テントの下、日陰とお茶でほっと一息。","en":"We took a breather in the shade beneath the tent, tea in hand.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900074","unitId":"ghs-tl:ccc3028:00075","en":"We breathe a sigh of relief with tea and shade under the tent.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000023c4:text","row":35311,"ordinal":76,"kind":"text","jp":"「ふいー、生き返るね、霧ちん」","en":"“Whew, that hits the spot. Doesn't it, Kiri-kins?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900075","unitId":"ghs-tl:ccc3028:00076","en":"Taichi: \"Wheeew, this is a return to life, innit Kiri-chin.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000247e:text","row":35312,"ordinal":77,"kind":"text","jp":"「え……？」","en":"“What...?”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900076","unitId":"ghs-tl:ccc3028:00077","en":"Kiri: \"Eh...?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000024aa:text","row":35313,"ordinal":78,"kind":"text","jp":"「水分をたっぷり出したあとだけに」","en":"“Especially after spilling so much fluid.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900077","unitId":"ghs-tl:ccc3028:00078","en":"Taichi: \"Right after losing all those fluids.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002568:text","row":35314,"ordinal":79,"kind":"text","jp":"「けほっ、こほっ！」","en":"“Kff! Cough, cough!”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900078","unitId":"ghs-tl:ccc3028:00079","en":"Kiri: \"Cough, kaff!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002618:text","row":35315,"ordinal":80,"kind":"text","jp":"「せんぱいっ！！」","en":"“Taichi!”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900079","unitId":"ghs-tl:ccc3028:00080","en":"Kiri: \"SENPAI!!!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000264a:text","row":35316,"ordinal":81,"kind":"text","jp":"「ははは」","en":"“Hahaha.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900080","unitId":"ghs-tl:ccc3028:00081","en":"Taichi: \"Ahahah!\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0257:00002748:text","row":35317,"ordinal":82,"kind":"text","jp":"「先輩たちもおしっこしてたんですか？」","en":"“Were both of you peeing?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900081","unitId":"ghs-tl:ccc3028:00082","en":"Miki: \"Senpai, you two've wee-weed too?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000278e:text","row":35318,"ordinal":83,"kind":"text","jp":"「二人で立ちションしてたんだ。どっちが飛ぶかって」","en":"“We were pissing standing up to see who could shoot farther.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900082","unitId":"ghs-tl:ccc3028:00083","en":"Taichi: \"'Twas the two of us standing and peeing, outdoors. Further flyer's winner.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000285c:text","row":35319,"ordinal":84,"kind":"text","jp":"「してないですっ！　できないですっ！」","en":"“We were not! I can't even pee standing up!”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900083","unitId":"ghs-tl:ccc3028:00084","en":"Kiri: \"We did not! I can not!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002920:text","row":35320,"ordinal":85,"kind":"text","jp":"「そ、そんな楽しそうなことをわたしにナイショで……」","en":"“Y-you did something that fun behind my back...?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900084","unitId":"ghs-tl:ccc3028:00085","en":"Miki: \"Yo-, you kept something that seems so fun secret from me...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000029f0:text","row":35321,"ordinal":86,"kind":"text","jp":"「美希……それは全然楽しそうじゃないから……」","en":"“Miki... nothing about that sounds fun...”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900085","unitId":"ghs-tl:ccc3028:00086","en":"Kiri: \"Miki... that doesn't seem fun at all for starters...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002abc:text","row":35322,"ordinal":87,"kind":"text","jp":"「そーかなー？」","en":"“You don’t think so?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900086","unitId":"ghs-tl:ccc3028:00087","en":"Miki: \"Doooes it nooow?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002ae4:text","row":35323,"ordinal":88,"kind":"text","jp":"近年、森林破壊並に急速にすれてきているが、美希は基本的にウブなはずだった。","en":"Lately, Miki had been shedding her innocence as fast as the planet shed forests, but she was supposed to be naive at heart.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900087","unitId":"ghs-tl:ccc3028:00088","en":"In recent years she has been losing it with a speed comparable to that of deforestation, but I still expected Miki would be fundamentally green.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002b46:text","row":35324,"ordinal":89,"kind":"text","jp":"……あれ。","en":"...Wait.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900088","unitId":"ghs-tl:ccc3028:00089","en":"...wait.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002b70:text","row":35325,"ordinal":90,"kind":"text","jp":"「それにそんな暴れてると、見えるぞ霧ちん」","en":"“And if you keep thrashing around like that, Kiri-kins, you're going to flash us.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900089","unitId":"ghs-tl:ccc3028:00090","en":"Taichi: \"By the way, if you act all that flustered they'll notice, Kiri-chin.\"","verdict":"confirmed_error","categories":["mistranslation","omission","word_choice"],"assessment":"The Japanese warns Kiri that if she keeps thrashing about, what is under her skirt will become visible. The English instead says unspecified people will notice her agitation, removing the concrete warning and joke.","remedy":"And if you keep thrashing around like that, we'll see them, Kiri-chin.","highlights":[{"color":"red","end":65,"start":51,"text":"they'll notice"}]}]},{"ref":"ccfc:sn:0257:00002cc0:text","row":35326,"ordinal":91,"kind":"text","jp":"「……………………」","en":"“........................”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900090","unitId":"ghs-tl:ccc3028:00091","en":"Kiri: \"............\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002d4d:text","row":35327,"ordinal":92,"kind":"text","jp":"スカートのはしを押さえて、大人しくなった。","en":"She clamped a hand over her skirt and went still.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900091","unitId":"ghs-tl:ccc3028:00092","en":"Pinning down the edge of her skirt, she became docile.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002d97:text","row":35328,"ordinal":93,"kind":"text","jp":"「ははは」","en":"“Hahaha.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900092","unitId":"ghs-tl:ccc3028:00093","en":"Taichi: \"Ahahah!\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0257:00002eec:text","row":35329,"ordinal":94,"kind":"text","jp":"「ところで太一、明日の放送だが……部長先輩に言われて原稿を書いてみた」","en":"“By the way, Taichi. About tomorrow's broadcast... the Club President asked me to write the script, so I gave it a try.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900093","unitId":"ghs-tl:ccc3028:00094","en":"Sakuraba: \"By the way, Taichi, broadcast's tomorrow, so... I tried to write the script that President-senpai asked for.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00002f52:text","row":35330,"ordinal":95,"kind":"text","jp":"「ほう、貴様がそんなことを？」","en":"“You? Writing a script?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900094","unitId":"ghs-tl:ccc3028:00095","en":"Taichi: \"Hoh, the bastard that you are managing something like that?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000300e:text","row":35331,"ordinal":96,"kind":"text","jp":"「ちょっと見てくれ。意見が聞きたい」","en":"“Take a look. I want your opinion.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900095","unitId":"ghs-tl:ccc3028:00096","en":"Sakuraba: \"Please have a look. I wish to hear your opinion.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003052:text","row":35332,"ordinal":97,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900096","unitId":"ghs-tl:ccc3028:00097","en":"Taichi: \"...\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0257:00003072:text","row":35333,"ordinal":98,"kind":"text","jp":"読めなかった。","en":"I couldn't read a word of it.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900097","unitId":"ghs-tl:ccc3028:00098","en":"I couldn't read it.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000030a0:text","row":35334,"ordinal":99,"kind":"text","jp":"「……何語だ？」","en":"“...What language is this?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900098","unitId":"ghs-tl:ccc3028:00099","en":"Taichi: \"...what language is this?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000314e:text","row":35335,"ordinal":100,"kind":"text","jp":"「万が一傍受されても意味がわからないよう、多重に暗号化してある」","en":"“I encrypted it in multiple layers so that anyone intercepting the signal would be unable to understand it.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900099","unitId":"ghs-tl:ccc3028:00100","en":"Sakuraba: \"In the thousand-to-one chance we are being monitored, they will not understand the meaning for it is encrypted with multiple ciphers.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000334d:text","row":35336,"ordinal":101,"kind":"text","jp":"殴った。","en":"I hit him.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900100","unitId":"ghs-tl:ccc3028:00101","en":"Punched.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003375:text","row":35337,"ordinal":102,"kind":"text","jp":"「意味ねーよ！」","en":"“THEN WHAT'S THE POINT!?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900101","unitId":"ghs-tl:ccc3028:00102","en":"Taichi: \"Meaningleeess!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003423:text","row":35338,"ordinal":103,"kind":"text","jp":"「……あああ、桜庭君に振った時間がまるまる無駄に……」","en":"“...All the time I gave Sakuraba... utterly wasted...”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900102","unitId":"ghs-tl:ccc3028:00103","en":"Misato: \"...aaah, the time that I gave Sakuraba-kun was wholly and completely wasted...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003479:text","row":35339,"ordinal":104,"kind":"text","jp":"「ＳＯＳで意味不明にしてどーすんだ！」","en":"“What's the point of an SOS no one can decipher!?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900103","unitId":"ghs-tl:ccc3028:00104","en":"Taichi: \"The hell we'd be doing by sending an SOS without a message you can understand!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000034b7:text","row":35340,"ordinal":105,"kind":"text","jp":"その時。","en":"At that moment—","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900104","unitId":"ghs-tl:ccc3028:00105","en":"And that moment,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000034fd:text","row":35341,"ordinal":106,"kind":"text","jp":"「あれ？」","en":"“Hm?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900105","unitId":"ghs-tl:ccc3028:00106","en":"Taichi: \"Eh?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000351f:text","row":35342,"ordinal":107,"kind":"text","jp":"風鈴が鳴った。","en":"A wind chime rang.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900106","unitId":"ghs-tl:ccc3028:00107","en":"wind bells chimed.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000354d:text","row":35343,"ordinal":108,"kind":"text","jp":"「風鈴じゃないか」","en":"“That’s a wind chime.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900107","unitId":"ghs-tl:ccc3028:00108","en":"Taichi: \"Ain't that a wind chime?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000035fd:text","row":35344,"ordinal":109,"kind":"text","jp":"「……つけた」","en":"“...I put it up.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900108","unitId":"ghs-tl:ccc3028:00109","en":"Sakuraba: \"...I put it there.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000036a9:text","row":35345,"ordinal":110,"kind":"text","jp":"「これから、みんなでここにつるむようになるのなら、と思って」","en":"“...I thought we might need one, if we're all going to be hanging out up here from now on.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900109","unitId":"ghs-tl:ccc3028:00110","en":"Sakuraba: \"I thought that we would all be mate-ing together here, I think.\"","verdict":"questionable","categories":["word_choice","register_voice"]}]},{"ref":"ccfc:sn:0257:00003723:text","row":35346,"ordinal":111,"kind":"text","jp":"「…………う」","en":"“............Ngh.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900110","unitId":"ghs-tl:ccc3028:00111","en":"Taichi: \"......ngh.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003749:text","row":35347,"ordinal":112,"kind":"text","jp":"たまに気のきいたことをする。","en":"Every now and then, he did something thoughtful.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900111","unitId":"ghs-tl:ccc3028:00112","en":"Occasionally, he does do something nifty.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:0000377d:text","row":35348,"ordinal":113,"kind":"text","jp":"人類もいなくなって。","en":"Humanity was gone.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900112","unitId":"ghs-tl:ccc3028:00113","en":"Humanity was no longer,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000037a9:text","row":35349,"ordinal":114,"kind":"text","jp":"希望もあるかどうかわからない。","en":"We didn't know whether there was any hope left.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900113","unitId":"ghs-tl:ccc3028:00114","en":"but whether hope had gone as well, I have no idea.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000037df:text","row":35350,"ordinal":115,"kind":"text","jp":"なのに、本当に……のんきなヤツだ。","en":"And yet here he was... so perfectly carefree.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900114","unitId":"ghs-tl:ccc3028:00115","en":"Despite this, seriously, this guy's... happy-go-lucky.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003821:text","row":35351,"ordinal":116,"kind":"text","jp":"「つるむともさ」","en":"“We will. All of us.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900115","unitId":"ghs-tl:ccc3028:00116","en":"Taichi: \"Let's mate-ing.\"","verdict":"questionable","categories":["word_choice","grammar"]}]},{"ref":"ccfc:sn:0257:000038cf:text","row":35352,"ordinal":117,"kind":"text","jp":"「だな」","en":"“Right.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:900116","unitId":"ghs-tl:ccc3028:00117","en":"Sakuraba: \"Let's.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003975:text","row":35353,"ordinal":118,"kind":"text","jp":"「……お願いします」","en":"“...Please do.”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900117","unitId":"ghs-tl:ccc3028:00118","en":"Misato: \"...with pleasure.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000039a9:text","row":35354,"ordinal":119,"kind":"text","jp":"「いつまででも」","en":"“For as long as you want.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900118","unitId":"ghs-tl:ccc3028:00119","en":"Taichi: \"To the ends of time.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:000039d1:text","row":35355,"ordinal":120,"kind":"text","jp":"嬉しそうに、先輩は目尻を下げた。","en":"Misato's eyes crinkled with delight.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900119","unitId":"ghs-tl:ccc3028:00120","en":"The corners of Senpai's lowered, seemingly in happiness.","verdict":"confirmed_error","categories":["omission","grammar"],"assessment":"The Japanese says the corners of her eyes lowered in a pleased expression. The English omits the possessed noun after 'Senpai's', leaving both the image and sentence incomplete.","remedy":"Senpai's eyes softened happily.","highlights":[{"color":"red","end":56,"start":0,"text":"The corners of Senpai's lowered, seemingly in happiness."}]}]},{"ref":"ccfc:sn:0257:00003a8f:text","row":35356,"ordinal":121,"kind":"text","jp":"「にしても霧ちん元気ないねー」","en":"“Still, Kiri-kins seems awfully down.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900120","unitId":"ghs-tl:ccc3028:00121","en":"Miki: \"Still, Kiri-chin, you don't look in spirits at all...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003b9f:text","row":35357,"ordinal":122,"kind":"text","jp":"「そ、そう？　そんなことないよ？」","en":"“D-do I? I’m fine.”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900121","unitId":"ghs-tl:ccc3028:00122","en":"Kiri: \"I-, don't? That's not true you know?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003be1:text","row":35358,"ordinal":123,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900122","unitId":"ghs-tl:ccc3028:00123","en":"Taichi: \"...\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0257:00003cd2:text","row":35359,"ordinal":124,"kind":"text","jp":"やっぱり無理してるのかな。","en":"Was she still pushing herself too hard?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900123","unitId":"ghs-tl:ccc3028:00124","en":"I knew it, this is just forced, is it?","verdict":"confirmed_error","categories":["wrong_subject","undertranslation","grammar"],"assessment":"The Japanese wonders whether Kiri is, as suspected, pushing herself too hard. The English makes an unspecified situation 'forced' and drops Kiri as the person overexerting herself.","remedy":"Maybe she really is pushing herself too hard.","highlights":[{"color":"red","end":30,"start":11,"text":"this is just forced"}]}]},{"ref":"ccfc:sn:0257:00003d04:text","row":35360,"ordinal":125,"kind":"text","jp":"真実も行為も、霧には負担すぎたのか。","en":"Had the truth—and what we'd done—been too much for her?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900124","unitId":"ghs-tl:ccc3028:00125","en":"Were that truth and those acts still too much of a burden for Kiri?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003d40:text","row":35361,"ordinal":126,"kind":"text","jp":"けど。","en":"But—","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900125","unitId":"ghs-tl:ccc3028:00126","en":"But.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003d5e:text","row":35362,"ordinal":127,"kind":"text","jp":"あと一日しかない。世界は。","en":"The world had only one day left.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900126","unitId":"ghs-tl:ccc3028:00127","en":"In this world.... there is one more day and no more.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003d90:text","row":35363,"ordinal":128,"kind":"text","jp":"霧を癒してやる手段も可能性も、俺にはないのだ。","en":"And I had no way to make Kiri whole again. No hope of one.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900127","unitId":"ghs-tl:ccc3028:00128","en":"I have neither chances nor methods to heal Kiri.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003dd6:text","row":35364,"ordinal":129,"kind":"text","jp":"だから。","en":"And so.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900128","unitId":"ghs-tl:ccc3028:00129","en":"Therefore,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0257:00003ecc:text","row":35365,"ordinal":130,"kind":"text","jp":"だから―――","en":"And so—","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900129","unitId":"ghs-tl:ccc3028:00130","en":"therefore---","verdict":"acceptable","categories":["word_choice"]}]}]}

{"schema":"mao-cross-channel-public-site-data/1","script":"0207","rows":[{"ref":"ccfc:sn:0207:0000011b:text","row":29682,"ordinal":1,"kind":"text","jp":"桜庭がいた。","en":"Sakuraba is here.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800503","unitId":"ghs-tl:ccc0031c:00001","en":"There was Sakuraba,","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000013f:text","row":29683,"ordinal":2,"kind":"text","jp":"ベッドに寝ていた。","en":"He's asleep on a bed.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800504","unitId":"ghs-tl:ccc0031c:00002","en":"sleeping in a bed.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000169:text","row":29684,"ordinal":3,"kind":"text","jp":"腹を出して、爆睡している。","en":"Belly out, dead to the world.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800505","unitId":"ghs-tl:ccc0031c:00003","en":"Belly out, fast asleep.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000001c0:text","row":29685,"ordinal":4,"kind":"text","jp":"「……ぐおー」","en":"“...Grrrnnk.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800506","unitId":"ghs-tl:ccc0031c:00004","en":"Sakuraba: \"...snooooooore.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000001e6:text","row":29686,"ordinal":5,"kind":"text","jp":"いびきだ。","en":"He's snoring.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800507","unitId":"ghs-tl:ccc0031c:00005","en":"Snoring.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000210:text","row":29687,"ordinal":6,"kind":"text","jp":"「桜庭？」","en":"“Sakuraba?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800508","unitId":"ghs-tl:ccc0031c:00006","en":"Taichi: \"Sakuraba?\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000257:text","row":29688,"ordinal":7,"kind":"text","jp":"「なんだ？」","en":"“What?”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800509","unitId":"ghs-tl:ccc0031c:00007","en":"Sakuraba: \"What?\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000027b:text","row":29689,"ordinal":8,"kind":"text","jp":"普通に返してくる。","en":"He answers normally.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800510","unitId":"ghs-tl:ccc0031c:00008","en":"He answers normally.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000002ad:text","row":29690,"ordinal":9,"kind":"text","jp":"「調子悪いのか？」","en":"“Not feeling well?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800511","unitId":"ghs-tl:ccc0031c:00009","en":"Taichi: \"Feeling off?\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000002fc:text","row":29691,"ordinal":10,"kind":"text","jp":"「カレーパンを食い過ぎた」","en":"“I ate too much curry bread.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800512","unitId":"ghs-tl:ccc0031c:00010","en":"Sakuraba: \"Ate too much curry bread.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000032e:text","row":29692,"ordinal":11,"kind":"text","jp":"起きてるのか。","en":"So he's awake?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800513","unitId":"ghs-tl:ccc0031c:00011","en":"Is he awake?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000354:text","row":29693,"ordinal":12,"kind":"text","jp":"しかし目は閉じている。","en":"But his eyes are closed.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800514","unitId":"ghs-tl:ccc0031c:00012","en":"But his eyes are closed.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000003a7:text","row":29694,"ordinal":13,"kind":"text","jp":"「四限分、カレーパンを食ったぞ」","en":"“I ate four periods' worth of curry bread.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800515","unitId":"ghs-tl:ccc0031c:00013","en":"Sakuraba: \"Been eating curry bread for four periods.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000003e7:text","row":29695,"ordinal":14,"kind":"text","jp":"「アホか」","en":"“You idiot.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800516","unitId":"ghs-tl:ccc0031c:00014","en":"Taichi: \"You dumbass.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000042e:text","row":29696,"ordinal":15,"kind":"text","jp":"「だいぶ単位は稼いだはずだ」","en":"“I must've earned a pile of credits.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800517","unitId":"ghs-tl:ccc0031c:00015","en":"Sakuraba: \"I expect to earn a considerable amount of school credit.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000046a:text","row":29697,"ordinal":16,"kind":"text","jp":"「いや、うち単位制じゃないし」","en":"“Our school doesn't use credits.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800518","unitId":"ghs-tl:ccc0031c:00016","en":"Taichi: \"Uhm, we're not on a credit system.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000004c5:text","row":29698,"ordinal":17,"kind":"text","jp":"「小さいことだ。俺は気にしない」","en":"“A minor detail. I don't mind.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800519","unitId":"ghs-tl:ccc0031c:00017","en":"Sakuraba: \"Tiny detail. I don't care.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000505:text","row":29699,"ordinal":18,"kind":"text","jp":"「そこはしとけよ」","en":"“You should.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800520","unitId":"ghs-tl:ccc0031c:00018","en":"Taichi: \"You should care about that!\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000554:text","row":29700,"ordinal":19,"kind":"text","jp":"「もう何も食えないぜ」","en":"“I can't eat another bite.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800521","unitId":"ghs-tl:ccc0031c:00019","en":"Sakuraba: \"I can't eat anything anymore.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000058a:text","row":29701,"ordinal":20,"kind":"text","jp":"「だろうな……」","en":"“I bet...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800522","unitId":"ghs-tl:ccc0031c:00020","en":"Taichi: \"Seems so...\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000005ba:text","row":29702,"ordinal":21,"kind":"text","jp":"「サンドイッチがあるんだけど」","en":"“I've got sandwiches, though.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800523","unitId":"ghs-tl:ccc0031c:00021","en":"Taichi: \"I got sandwiches though.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000615:text","row":29703,"ordinal":22,"kind":"text","jp":"「ぐおー」","en":"“Grrrnnk.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800524","unitId":"ghs-tl:ccc0031c:00022","en":"Sakuraba: \"Snooore.\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000637:text","row":29704,"ordinal":23,"kind":"text","jp":"寝ていた。","en":"He was asleep.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800525","unitId":"ghs-tl:ccc0031c:00023","en":"Asleep.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000659:text","row":29705,"ordinal":24,"kind":"text","jp":"もしかして今までのも全部寝言か。","en":"Was everything before this sleep talk too?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800526","unitId":"ghs-tl:ccc0031c:00024","en":"Could it be that everything so far has been sleeptalk?","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000699:text","row":29706,"ordinal":25,"kind":"text","jp":"「友情は見返りを」","en":"“Friendship asks for nothing—”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800527","unitId":"ghs-tl:ccc0031c:00025","en":"Taichi: \"Friendship demands...\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000006e8:text","row":29707,"ordinal":26,"kind":"text","jp":"「求めない」","en":"“—in return.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800528","unitId":"ghs-tl:ccc0031c:00026","en":"Sakuraba: \"Nothing in return.\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:0000070c:text","row":29708,"ordinal":27,"kind":"text","jp":"親指を立てた。","en":"I give him a thumbs-up.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800529","unitId":"ghs-tl:ccc0031c:00027","en":"We stuck our thumbs up.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000757:text","row":29709,"ordinal":28,"kind":"text","jp":"「ぐおー」","en":"“Grrrnnk.”","speakerJa":"桜庭","speakerEn":"Sakuraba","ghs":[{"id":"ghs-tl:finding:800530","unitId":"ghs-tl:ccc0031c:00028","en":"Sakuraba: \"Snooore.\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:00000781:text","row":29710,"ordinal":29,"kind":"text","jp":"「何の悩みもないのか、こいつには……」","en":"“Does this guy not have a care in the world...?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:800531","unitId":"ghs-tl:ccc0031c:00029","en":"Taichi: \"Totally untroubled this guy here...\"","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0207:000007bf:text","row":29711,"ordinal":30,"kind":"text","jp":"恐るべし。","en":"Fearsome.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800532","unitId":"ghs-tl:ccc0031c:00030","en":"He's not to be underestimated.","verdict":"acceptable","categories":["presentation"]}]}]}

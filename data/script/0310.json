ategories":["overinterpretation","register_voice"]}]},{"ref":"ccfc:sn:0310:0000040b:text","row":40041,"ordinal":11,"kind":"text","jp":"美希は、お姫様扱いに弱い。","en":"Miki was a sucker for princess treatment.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:904747","unitId":"ghs-tl:ccd0016b:00011","en":"Miki is weak to being treated like a princess.","verdict":"confirmed_error","categories":["idiom_calque","grammar"],"assessment":"The idiomatic English construction is 'has a weakness for' or 'is susceptible to,' not 'is weak to.'","remedy":"has a weakness for being treated like a princess","highlights":[{"color":"red","end":29,"start":8,"text":"weak to being treated"}]}]},{"ref":"ccfc:sn:0310:0000043d:text","row":40042,"ordinal":12,"kind":"text","jp":"再度キス。","en":"I kissed her hand again.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:904748","unitId":"ghs-tl:ccd0016b:00012","en":"Kiss, second time.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0310:000004e5:text","row":40043,"ordinal":13,"kind":"text","jp":"「やだぁ……」","en":"“Oh, stop...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:904749","unitId":"ghs-tl:ccd0016b:00013","en":"Miki: \"But no...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0310:0000050b:text","row":40044,"ordinal":14,"kind":"text","jp":"全然嫌そうでない。","en":"She didn't look like she wanted me to stop—not even a little.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:904750","unitId":"ghs-tl:ccd0016b:00014","en":"No dislike at all, it seems.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0310:00000558:text","row":40045,"ordinal":15,"kind":"text","jp":"「…………」","en":"“............”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:904751","unitId":"ghs-tl:ccd0016b:00015","en":"Kiri: \"......\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0310:0000057c:text","row":40046,"ordinal":16,"kind":"tex
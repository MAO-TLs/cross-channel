{"schema":"mao-cross-channel-public-site-data/1","script":"0184","rows":[{"ref":"ccfc:sn:0184:0000012b:text","row":28708,"ordinal":1,"kind":"text","jp":"「せんぱいっ」","en":"“Taichi!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012020","unitId":"ghs-tl:ccc0015:00001","en":"Miki: \"Senpai!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:00000151:text","row":28709,"ordinal":2,"kind":"text","jp":"背後から声をかけられた。","en":"A voice called to me from behind.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012021","unitId":"ghs-tl:ccc0015:00002","en":"I was called from the back.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000001ea:text","row":28710,"ordinal":3,"kind":"text","jp":"「よー」","en":"“Hey.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012022","unitId":"ghs-tl:ccc0015:00003","en":"Taichi: \"Yooo.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:00000212:text","row":28711,"ordinal":4,"kind":"text","jp":"「掃除終わった？」","en":"“Done cleaning?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012023","unitId":"ghs-tl:ccc0015:00004","en":"Taichi: \"Finished cleaning?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:0000029d:text","row":28712,"ordinal":5,"kind":"text","jp":"美希はぎょっとした。","en":"Miki jolted.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012024","unitId":"ghs-tl:ccc0015:00005","en":"Miki was startled.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000002ee:text","row":28713,"ordinal":6,"kind":"text","jp":"「よ、よく掃除をしていたとご存じで……」","en":"“H-how did you know I’d been cleaning…?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012025","unitId":"ghs-tl:ccc0015:00006","en":"Miki: \"Wo-, wow, you're aware that I've been cleaning...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000003b4:text","row":28714,"ordinal":7,"kind":"text","jp":"「見てました？」","en":"“Were you watching me?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012026","unitId":"ghs-tl:ccc0015:00007","en":"Miki: \"Did you see me?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000003dc:text","row":28715,"ordinal":8,"kind":"text","jp":"しまった。","en":"Damn.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012027","unitId":"ghs-tl:ccc0015:00008","en":"Dammit.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000003fe:text","row":28716,"ordinal":9,"kind":"text","jp":"日記情報。極秘。","en":"Diary intel. Top secret.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012028","unitId":"ghs-tl:ccc0015:00009","en":"Diary information. Top secret.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:0000042e:text","row":28717,"ordinal":10,"kind":"text","jp":"「……ナイショにする必要もないのかな」","en":"“…Though maybe there’s no need to keep it secret.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012029","unitId":"ghs-tl:ccc0015:00010","en":"Taichi: \"...is keeping it secret even necessary now.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000004f2:text","row":28718,"ordinal":11,"kind":"text","jp":"「ナイショとは？」","en":"“Keep what secret?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012030","unitId":"ghs-tl:ccc0015:00011","en":"Miki: \"What's secret?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:00000524:text","row":28719,"ordinal":12,"kind":"text","jp":"「あーいや、こっちのこと」","en":"“Oh, nothing. Just thinking out loud.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012031","unitId":"ghs-tl:ccc0015:00012","en":"Taichi: \"Ahhh nothing, just talking to myself.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:00000556:text","row":28720,"ordinal":13,"kind":"text","jp":"いいや、しばらく伏せておこう。","en":"No. I’ll keep it under wraps for now.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012032","unitId":"ghs-tl:ccc0015:00013","en":"Ah well, I'll keep it hidden for the time being.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:0000058c:text","row":28721,"ordinal":14,"kind":"text","jp":"確かセクハラとかするんだよな。","en":"If I remember right, this is where I sexually harass her or something.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012033","unitId":"ghs-tl:ccc0015:00014","en":"I should definitely do some of that sexual harassment, shouldn't I.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000005c2:text","row":28722,"ordinal":15,"kind":"text","jp":"……俺もお盛んだな。","en":"…I really am a horndog.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012034","unitId":"ghs-tl:ccc0015:00015","en":"...I'm so debauched.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:000005ee:text","row":28723,"ordinal":16,"kind":"text","jp":"どうしたものか。","en":"What should I do?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012035","unitId":"ghs-tl:ccc0015:00016","en":"Which to do.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0184:0000063e:choice:01","row":28724,"ordinal":17,"kind":"choice","jp":"セクハラ ＆ サイン","en":"Sexual Harassment & Autographs","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0184:0000063e:choice:02","row":28725,"ordinal":18,"kind":"choice","jp":"デッド or アライブ","en":"Dead or Alive","speakerJa":"","speakerEn":"","ghs":[]}]}

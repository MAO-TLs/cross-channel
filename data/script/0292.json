{"schema":"mao-cross-channel-public-site-data/1","script":"0292","rows":[{"ref":"ccfc:sn:0292:00000107:text","row":39283,"ordinal":1,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:903996","unitId":"ghs-tl:ccd0006:00001","en":"Taichi: \"...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0292:00000127:text","row":39284,"ordinal":2,"kind":"text","jp":"まわる世界、か。","en":"The world going round and round, huh.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903997","unitId":"ghs-tl:ccd0006:00002","en":"A revolving world, then.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0292:0000014f:text","row":39285,"ordinal":3,"kind":"text","jp":"この月曜を、俺は何度繰り返してきたんだろう。","en":"How many times had I lived through this Monday?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903998","unitId":"ghs-tl:ccd0006:00003","en":"How many times have I even repeated this very Monday?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0292:00000193:text","row":39286,"ordinal":4,"kind":"text","jp":"などと考えていると。","en":"That was what I was thinking when—","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903999","unitId":"ghs-tl:ccd0006:00004","en":"And while immersed in all thoughts like that,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0292:000001bf:text","row":39287,"ordinal":5,"kind":"text","jp":"美希を発見。","en":"I spotted Miki.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:904000","unitId":"ghs-tl:ccd0006:00005","en":"I spot Miki.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0292:000001e3:text","row":39288,"ordinal":6,"kind":"text","jp":"向こうも俺を発見。","en":"She saw me too.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:904001","unitId":"ghs-tl:ccd0006:00006","en":"I'm also spotted in return.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:029
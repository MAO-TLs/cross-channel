{"schema":"mao-cross-channel-public-site-data/1","script":"0056","rows":[{"ref":"ccfc:sn:0056:00000031:text","row":14610,"ordinal":1,"kind":"text","jp":"旅立つ。","en":"I head off.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:001279","unitId":"ghs-tl:cca0009c:00001","en":"I begin on my way.","verdict":"acceptable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0056:00000059:text","row":14611,"ordinal":2,"kind":"text","jp":"「そうだ、美希」","en":"“Oh, right. Miki.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:001280","unitId":"ghs-tl:cca0009c:00002","en":"Taichi: \"Ah, yes, Miki.\"","verdict":"acceptable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0056:00000081:text","row":14612,"ordinal":3,"kind":"text","jp":"立ち止まる。","en":"I stop.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:001281","unitId":"ghs-tl:cca0009c:00003","en":"I stop.","verdict":"acceptable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0056:000000a5:text","row":14613,"ordinal":4,"kind":"text","jp":"大切なことを伝え忘れていた。","en":"I had forgotten to tell her something important.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:001282","unitId":"ghs-tl:cca0009c:00004","en":"I forgot to tell her something very important.","verdict":"acceptable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0056:000000fe:text","row":14614,"ordinal":5,"kind":"text","jp":"「はい」","en":"“Yes.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:001283","unitId":"ghs-tl:cca0009c:00005","en":"Miki: \"Yes?\"","verdict":"acceptable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0056:0000012b:text","row":14615,"ordinal":6,"kind":"text","jp":"「そろそろ部活、活動再開するってさ」","en":"“I hear the club’s about to start up again.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:001284","unitId":"ghs-tl:cca0009c:00006","en":"Taichi: \"I'm hearing that Club is going to be starting up again any time now.\"","verdict":"confirmed_error","categories":["grammar","register_voice","word_choice"],"assessment":"He reports that club activities will be resuming soon. 'I'm hearing that Club' treats the activity as a proper-named entity and uses a needlessly progressive reporting construction, producing malformed dialogue.","remedy":"Use 'I hear club activities are starting up again soon.'","highlights":[{"color":"red","end":76,"start":9,"text":"I'm hearing that Club is going to be starting up again any time now"}]}]}]}

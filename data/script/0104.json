{"schema":"mao-cross-channel-public-site-data/1","script":"0104","rows":[{"ref":"ccfc:sn:0104:000000ff:text","row":20723,"ordinal":1,"kind":"text","jp":"相変わらず、睦美おばさんの姿はない。","en":"As usual, Aunt Mutsumi was nowhere to be seen.","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0104:0000013b:text","row":20724,"ordinal":2,"kind":"text","jp":"かわりにメモが置いてある。","en":"There was a note in her place.","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0104:0000016d:text","row":20725,"ordinal":3,"kind":"text","jp":"『夕食がないこともない』","en":"“It’s not that there isn’t any dinner.”","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-public-alias-group:01140","unitId":"ghs-tl:cca0015c:00003","unitIds":["ghs-tl:cca0015c:00003"],"en":"『There may be no absence of dinner.』","verdict":"withheld","categories":[],"renderGroup":{"id":"ghs-public-alias-group:01140","shape":"1:1","sourceRefs":["ccfc:sn:0104:0000016d:text"],"continuationRefs":[]}}]},{"ref":"ccfc:sn:0104:000001a5:text","row":20726,"ordinal":4,"kind":"text","jp":"「行く行く～」","en":"“I’m coming, I’m coming!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[]},{"ref":"ccfc:sn:0104:000001cb:text","row":20727,"ordinal":5,"kind":"text","jp":"うきうき家を出る。","en":"I left the house in high spirits.","speakerJa":"","speakerEn":"","ghs":[]}]}

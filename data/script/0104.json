{"schema":"mao-cross-channel-public-site-data/1","script":"0104","rows":[{"ref":"ccfc:sn:0104:000000ff:text","row":21241,"ordinal":1,"kind":"text","jp":"相変わらず、睦美おばさんの姿はない。","en":"Aunt Mutsumi was nowhere to be found, as usual.","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0104:0000013b:text","row":21242,"ordinal":2,"kind":"text","jp":"かわりにメモが置いてある。","en":"Instead, there was a note.","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0104:0000016d:text","row":21243,"ordinal":3,"kind":"text","jp":"『夕食がないこともない』","en":"‘It’s not like there won’t be dinner.’","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-public-alias-group:01140","unitId":"ghs-tl:cca0015c:00003","unitIds":["ghs-tl:cca0015c:00003"],"en":"『There may be no absence of dinner.』","verdict":"withheld","categories":[],"renderGroup":{"id":"ghs-public-alias-group:01140","shape":"1:1","sourceRefs":["ccfc:sn:0104:0000016d:text"],"continuationRefs":[]}}]},{"ref":"ccfc:sn:0104:000001a5:text","row":21244,"ordinal":4,"kind":"text","jp":"「行く行く～」","en":"“I’m coming, I’m coming!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[]},{"ref":"ccfc:sn:0104:000001cb:text","row":21245,"ordinal":5,"kind":"text","jp":"うきうき家を出る。","en":"I skipped out of the house.","speakerJa":"","speakerEn":"","ghs":[]}]}

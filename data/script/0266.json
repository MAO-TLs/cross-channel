007:00088","en":"Miki: \"...mh, well... that wasn't really...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00001fb0:text","row":36289,"ordinal":89,"kind":"text","jp":"「霧ちん助けた動きは良かったなー。別人かと思ったぞ」","en":"“That was some move, saving Kiri-kins. For a second I thought you were someone else.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:901051","unitId":"ghs-tl:ccc4007:00089","en":"Taichi: \"The way you moved to save Kiri-chin that was sooo awesome. I totally thought you were someone else!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002004:text","row":36290,"ordinal":90,"kind":"text","jp":"「本当に……」","en":"“Really...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:901052","unitId":"ghs-tl:ccc4007:00090","en":"Taichi: \"Seriously...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:0000202a:text","row":36291,"ordinal":91,"kind":"text","jp":"見違えるほどに敏捷で。","en":"She'd moved so fast I hardly recognized her.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901053","unitId":"ghs-tl:ccc4007:00091","en":"She had agility at a level beyond recognition.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002058:text","row":36292,"ordinal":92,"kind":"text","jp":"けど美希って、そんな鋭かったかな。","en":"But had Miki always been that quick?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901054","unitId":"ghs-tl:ccc4007:00092","en":"But I wonder, was Miki always that keen?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002092:text","row":36293,"ordinal":93,"kind":"text","jp":"俺を引きずって、自宅まで運んだんだっけ。","en":"Wasn't she the one who'd dragged me all the way home?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901055","unitId":"ghs-tl:ccc4007:00093","en":"And she had dragged me, moved me all the way to my home, right?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:000020d2:text","row":36294,"ordinal":94,"kind":"text","jp":"そんな力、あるのかな。","en":"Was she really capable of that?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901056","unitId":"ghs-tl:ccc4007:00094","en":"Does she even have that kind of strength?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002108:text","row":36295,"ordinal":95,"kind":"text","jp":"「蹴りも鋭かったし……そういえば……」","en":"“Her kicks were sharp too... Come to think of it...”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:901057","unitId":"ghs-tl:ccc4007:00095","en":"Taichi: \"Your kicks were also sharp... now that I recall...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002146:text","row":36296,"ordinal":96,"kind":"text","jp":"考え込む。","en":"I thought it over.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901058","unitId":"ghs-tl:ccc4007:00096","en":"I ponder, deeply.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002168:text","row":36297,"ordinal":97,"kind":"text","jp":"なにか引っかかっている。","en":"Something didn't add up.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901059","unitId":"ghs-tl:ccc4007:00097","en":"Something is worrying me very much.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:0000221e:text","row":36298,"ordinal":98,"kind":"text","jp":"「あ、あのー」","en":"“U-um...”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:901060","unitId":"ghs-tl:ccc4007:00098","en":"Miki: \"Ah, uhmmm!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:0000224c:text","row":36299,"ordinal":99,"kind":"text","jp":"「ん？」","en":"“Hm?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:901061","unitId":"ghs-tl:ccc4007:00099","en":"Taichi: \"Hm?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:000022f2:text","row":36300,"ordinal":100,"kind":"text","jp":"「……ちゅ」","en":"“...Mwah.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:901062","unitId":"ghs-tl:ccc4007:00100","en":"Miki: \"...pchk!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002316:text","row":36301,"ordinal":101,"kind":"text","jp":"頬に。","en":"On the cheek.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901063","unitId":"ghs-tl:ccc4007:00101","en":"On the cheek.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002334:text","row":36302,"ordinal":102,"kind":"text","jp":"曜子ちゃん以外からされたのは初めてだった。","en":"It was the first time anyone but Youko had kissed me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901064","unitId":"ghs-tl:ccc4007:00102","en":"Outside of Youko-chan, this was the first time this happened to me.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:000023fc:text","row":36303,"ordinal":103,"kind":"text","jp":"「お礼の前払いですっ」","en":"“My down payment on the thank-you!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:901065","unitId":"ghs-tl:ccc4007:00103","en":"Miki: \"Advance payment on gratitude!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002432:text","row":36304,"ordinal":104,"kind":"text","jp":"「お、お、お釣り払っちゃうんだからしてっ！」","en":"“I-I-I'll even throw in change, so kiss me!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:901066","unitId":"ghs-tl:ccc4007:00104","en":"Taichi: \"I-, I-, I am giving you the chaaange!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0266:00002476:text","row":36305,"ordinal":105,"kind":"text","jp":"俺は美希に飛び込んでいく。","en":"I lunged at Miki.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:901067","unitId":"ghs-tl:ccc4007:00105","en":"I leap onto Miki.","verdict":"acceptable","categories":["word_choice"]}]}]}

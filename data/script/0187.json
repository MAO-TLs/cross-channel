{"schema":"mao-cross-channel-public-site-data/1","script":"0187","rows":[{"ref":"ccfc:sn:0187:00000056:text","row":28889,"ordinal":1,"kind":"text","jp":"「……？」","en":"“...?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012194","unitId":"ghs-tl:ccc0017:00001","en":"Miki: \"...?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:00000080:text","row":28890,"ordinal":2,"kind":"text","jp":"「そーそー、食い物はちゃんとありますか？」","en":"“Oh, right. You have enough to eat?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012195","unitId":"ghs-tl:ccc0017:00002","en":"Taichi: \"Say say, you do have some proper food?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:00000148:text","row":28891,"ordinal":3,"kind":"text","jp":"「はい。全然平気です」","en":"“Yes. I'm perfectly fine.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012196","unitId":"ghs-tl:ccc0017:00003","en":"Miki: \"Yes. It's completely all right.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:000001fc:text","row":28892,"ordinal":4,"kind":"text","jp":"「手料理といいますと、ちとアレなのですが」","en":"“I wouldn't exactly call it home cooking, though.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012197","unitId":"ghs-tl:ccc0017:00004","en":"Miki: \"But when it comes to handmade cooking, it's a bit like, you know...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:0000023e:text","row":28893,"ordinal":5,"kind":"text","jp":"苦笑い。","en":"She smiled wryly.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:012198","unitId":"ghs-tl:ccc0017:00005","en":"A bitter smile.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:00000266:text","row":28894,"ordinal":6,"kind":"text","jp":"「昼飯は缶詰だったりして」","en":"“What, lunch from a can?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012199","unitId":"ghs-tl:ccc0017:00006","en":"Taichi: \"Lunch is therefore canned food.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:0000031e:text","row":28895,"ordinal":7,"kind":"text","jp":"「まさに食パンと缶詰です」","en":"“Sliced bread and canned food. Exactly.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012200","unitId":"ghs-tl:ccc0017:00007","en":"Miki: \"Exactly, bread and canned food.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:00000358:text","row":28896,"ordinal":8,"kind":"text","jp":"「……貧乏くさい弁当だな」","en":"“...That's a pretty sorry excuse for lunch.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:012201","unitId":"ghs-tl:ccc0017:00008","en":"Taichi: \"...that's one damn destitute lunch.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:0000040b:text","row":28897,"ordinal":9,"kind":"text","jp":"「たはは」","en":"“Eheh.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:012202","unitId":"ghs-tl:ccc0017:00009","en":"Miki: \"Tahahah.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0187:00000455:choice:01","row":28898,"ordinal":10,"kind":"choice","jp":"サンドイッチあげる","en":"Give her a sandwich","speakerJa":"","speakerEn":"","ghs":[]},{"ref":"ccfc:sn:0187:00000455:choice:02","row":28899,"ordinal":11,"kind":"choice","jp":"あげない","en":"Don't give her a sandwich","speakerJa":"","speakerEn":"","ghs":[]}]}

{"schema":"mao-cross-channel-public-site-data/1","script":"0213","rows":[{"ref":"ccfc:sn:0213:0000018a:text","row":29888,"ordinal":1,"kind":"text","jp":"何もなく、誰もいない家に戻る。","en":"I returned to a house with nothing and no one in it.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800706","unitId":"ghs-tl:ccc0035b:00001","en":"There is nothing and no one in the house I return to.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0213:000001c0:text","row":29889,"ordinal":2,"kind":"text","jp":"虫の音色も聞こえない。","en":"Not even the song of insects could be heard.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800707","unitId":"ghs-tl:ccc0035b:00002","en":"The timbre of insects I can't hear either.","verdict":"questionable","categories":["idiom_calque","word_choice"]}]},{"ref":"ccfc:sn:0213:000002c6:text","row":29890,"ordinal":3,"kind":"text","jp":"蝋燭に火を灯す。","en":"I lit a candle.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800708","unitId":"ghs-tl:ccc0035b:00003","en":"I ignite the wick of a candle.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0213:000002ee:text","row":29891,"ordinal":4,"kind":"text","jp":"やることはたいしてない。","en":"There wasn't much to do.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800709","unitId":"ghs-tl:ccc0035b:00004","en":"I don't really have much to do.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0213:0000031e:text","row":29892,"ordinal":5,"kind":"text","jp":"日記を書く。","en":"I wrote in the diary.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800710","unitId":"ghs-tl:ccc0035b:00005","en":"I write the diary.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0213:00000342:text","row":29893,"ordinal":6,"kind":"text","jp":"克明に書く。","en":"I wrote down every last detail.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800711","unitId":"ghs-tl:ccc0035b:00006","en":"I write thoroughly, diligently.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0213:00000366:text","row":29894,"ordinal":7,"kind":"text","jp":"やることがあるのはいいことだ。","en":"It was good to have something to do.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:800712","unitId":"ghs-tl:ccc0035b:00007","en":"Having something to do is a good thing.","verdict":"acceptable","categories":["presentation"]}]}]}

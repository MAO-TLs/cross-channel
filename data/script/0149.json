"word_choice"]}]},{"ref":"ccfc:sn:0149:000003af:text","row":25642,"ordinal":13,"kind":"text","jp":"自然に、机に押し倒す。","en":"Then, naturally, I push her down onto the desk.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:009093","unitId":"ghs-tl:ccb2013:00183","en":"And with a natural motion pushed her down on the desk.","verdict":"acceptable","categories":["word_choice"]}]}]}

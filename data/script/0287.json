9,"kind":"text","jp":"そして彼女の鼻をつまむ。","en":"Then I pinched her nose shut.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903751","unitId":"ghs-tl:ccd0003:00039","en":"I then pinched her nose,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00000f9f:text","row":39036,"ordinal":40,"kind":"text","jp":"酸欠で口を開く瞬間を待った。","en":"I waited for her to run out of air and open her mouth.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903752","unitId":"ghs-tl:ccd0003:00040","en":"and waited for the moment when oxygen deprivation made her open her mouth.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:0000103c:text","row":39037,"ordinal":41,"kind":"text","jp":"「……」","en":"“...”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[{"id":"ghs-tl:finding:903753","unitId":"ghs-tl:ccd0003:00041","en":"Youko: \"...\"","verdict":"cannot_adjudicate","categories":["presentation"]}]},{"ref":"ccfc:sn:0287:0000105c:text","row":39038,"ordinal":42,"kind":"text","jp":"五秒。","en":"Five seconds.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903754","unitId":"ghs-tl:ccd0003:00042","en":"Five seconds.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:0000107a:text","row":39039,"ordinal":43,"kind":"text","jp":"十秒。","en":"Ten.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903755","unitId":"ghs-tl:ccd0003:00043","en":"Ten seconds.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00001098:text","row":39040,"ordinal":44,"kind":"text","jp":"三十秒。","en":"Thirty.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903756","unitId":"ghs-tl:ccd0003:00044","en":"Thirty seconds.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:000010b8:text","row":39041,"ordinal":45,"kind":"text","jp":"一分。","en":"One minute.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903757","unitId":"ghs-tl:ccd0003:00045","en":"One minute.",
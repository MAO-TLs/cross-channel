ice"]}]},{"ref":"ccfc:sn:0287:00001d57:text","row":39081,"ordinal":85,"kind":"text","jp":"涙目で紙袋を渡そうとしてくる。","en":"Tears in her eyes, she tried to hand me a paper bag.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903797","unitId":"ghs-tl:ccd0003:00085","en":"and with teary eyes she hands over a paper bag.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00001d8d:text","row":39082,"ordinal":86,"kind":"text","jp":"多少は罪悪感も刺激された。","en":"I felt a twinge of guilt.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903798","unitId":"ghs-tl:ccd0003:00086","en":"That stimulated some sort-of feelings of guilt.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00001dc7:text","row":39083,"ordinal":87,"kind":"text","jp":"「……わかった、もらうよ」","en":"“...Fine. I'll take it.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:903799","unitId":"ghs-tl:ccd0003:00087","en":"Taichi: \"...got it, I'll take that.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00001df9:text","row":39084,"ordinal":88,"kind":"text","jp":"母親ばりだ。","en":"Like a mother.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903800","unitId":"ghs-tl:ccd0003:00088","en":"Motherlike.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0287:00001e1d:text","row":39085,"ordinal":89,"kind":"text","jp":"母親いないけど。","en":"Not that I had one.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:903801","unitId":"ghs-tl:ccd0003:00089","en":"But a mother I don't have.","verdict":"acceptable","categories":["presentation"]}]},{"ref":"ccfc:sn:0287:00001ecb:text","row":39086,"ordinal":90,"kind":"text","jp":"「いってらっしゃい」","en":"“Have a good day.”","speakerJa":"曜子","speakerEn":"Yoko","ghs":[{"id":"ghs-tl:finding:903802","unitId":"ghs-tl:ccd0003:00090","en":"Youko: \"Have a safe walk.\"","verdict":"questionable","categories":["register_voice"]}]},{"ref":"ccfc:sn:0287:00001ef7:text","ro
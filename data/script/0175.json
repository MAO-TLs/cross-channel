{"schema":"mao-cross-channel-public-site-data/1","script":"0175","rows":[{"ref":"ccfc:sn:0175:00000178:text","row":27968,"ordinal":1,"kind":"text","jp":"……寄っていくか。","en":"…Maybe I’d stop in.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011313","unitId":"ghs-tl:ccc0009:00001","en":"...should I drop by, then?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000001aa:text","row":27969,"ordinal":2,"kind":"text","jp":"「む」","en":"“Hm.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011314","unitId":"ghs-tl:ccc0009:00002","en":"Taichi: \"Mngh.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000001c8:text","row":27970,"ordinal":3,"kind":"text","jp":"殺気。","en":"Killing intent.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011315","unitId":"ghs-tl:ccc0009:00003","en":"Thirst for blood.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000001e6:text","row":27971,"ordinal":4,"kind":"text","jp":"店の入り口に張りつく。","en":"I pressed myself flat beside the entrance.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011316","unitId":"ghs-tl:ccc0009:00004","en":"It clings to the entrance of the store.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000214:text","row":27972,"ordinal":5,"kind":"text","jp":"中をうかがう。","en":"I peered inside.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011317","unitId":"ghs-tl:ccc0009:00005","en":"I peep inside.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000023a:text","row":27973,"ordinal":6,"kind":"text","jp":"敵か味方か。","en":"Friend or foe?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011318","unitId":"ghs-tl:ccc0009:00006","en":"Friend or foe?","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000266:text","row":27974,"ordinal":7,"kind":"text","jp":"「……やま？」","en":"“…Mountain?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011319","unitId":"ghs-tl:ccc0009:00007","en":"Taichi: \"...yama?\" (mountain)","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000002b1:text","row":27975,"ordinal":8,"kind":"text","jp":"「……かわ」","en":"“…River.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011320","unitId":"ghs-tl:ccc0009:00008","en":"Miki: \"...kawa.\" (river)","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000002fa:text","row":27976,"ordinal":9,"kind":"text","jp":"「天上天下？」","en":"“In heaven and on earth?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011321","unitId":"ghs-tl:ccc0009:00009","en":"Miki: \"Throughout Heaven and Earth?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000328:text","row":27977,"ordinal":10,"kind":"text","jp":"「ワキガ独走」","en":"“My BO alone reigns supreme.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011322","unitId":"ghs-tl:ccc0009:00010","en":"Taichi: \"Body odor stands alone.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000373:text","row":27978,"ordinal":11,"kind":"text","jp":"「……どうぞ」","en":"“…Come in.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011323","unitId":"ghs-tl:ccc0009:00011","en":"Miki: \"...come in.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000399:text","row":27979,"ordinal":12,"kind":"text","jp":"店の中に入る。","en":"I went inside.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011324","unitId":"ghs-tl:ccc0009:00012","en":"I enter inside the shop.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000045f:text","row":27980,"ordinal":13,"kind":"text","jp":"「美希か……誰かと思ったぞ」","en":"“Oh, it’s you, Miki… I was wondering who it was.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011325","unitId":"ghs-tl:ccc0009:00013","en":"Taichi: \"Miki then... who did you think it was.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000519:text","row":27981,"ordinal":14,"kind":"text","jp":"「おはようございます、先輩」","en":"“Good morning, Taichi.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011326","unitId":"ghs-tl:ccc0009:00014","en":"Miki: \"Good morning, Senpai.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000555:text","row":27982,"ordinal":15,"kind":"text","jp":"「殺気などを出しているから」","en":"“You were the one radiating killing intent.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011327","unitId":"ghs-tl:ccc0009:00015","en":"Taichi: \"Because, you've been emitting what seems like thirst for blood.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000060f:text","row":27983,"ordinal":16,"kind":"text","jp":"「閉鎖空間でなにかあると逃げ場なくてイヤじゃないですか」","en":"“If something happens in an enclosed space, there’s nowhere to run. Don’t you hate that?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011328","unitId":"ghs-tl:ccc0009:00016","en":"Miki: \"If there's something in a sealed space, isn't it bad not to have a place to escape to?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000667:text","row":27984,"ordinal":17,"kind":"text","jp":"「もっともだ」","en":"“Fair point.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011329","unitId":"ghs-tl:ccc0009:00017","en":"Taichi: \"Extremely so.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000068d:text","row":27985,"ordinal":18,"kind":"text","jp":"古い記憶に思いを馳せる。","en":"I cast my mind back to an old memory.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011330","unitId":"ghs-tl:ccc0009:00018","en":"My thoughts run to old memories.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000006c5:text","row":27986,"ordinal":19,"kind":"text","jp":"「制服着てるってことは、学校に行くつもりなのかな？」","en":"“You’re in uniform. Planning to go to school?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011331","unitId":"ghs-tl:ccc0009:00019","en":"Taichi: \"You're wearing the uniform, you wanna go to school then?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000736:text","row":27987,"ordinal":20,"kind":"text","jp":"「そーです。他にすることないですし」","en":"“Yup. There’s nothing else to do.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011332","unitId":"ghs-tl:ccc0009:00020","en":"Miki: \"Indeed. There's nothing else to do after all.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000077a:text","row":27988,"ordinal":21,"kind":"text","jp":"「同じか」","en":"“Same as me, then.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011333","unitId":"ghs-tl:ccc0009:00021","en":"Taichi: \"You too?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000822:text","row":27989,"ordinal":22,"kind":"text","jp":"「ですねー」","en":"“Looks like it.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011334","unitId":"ghs-tl:ccc0009:00022","en":"Miki: \"Seems so.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000846:text","row":27990,"ordinal":23,"kind":"text","jp":"無邪気だった。","en":"She was all innocence.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011335","unitId":"ghs-tl:ccc0009:00023","en":"What simple-minded innocence we had.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000874:text","row":27991,"ordinal":24,"kind":"text","jp":"「俺にも飲み物を」","en":"“Get me something to drink too.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011336","unitId":"ghs-tl:ccc0009:00024","en":"Taichi: \"A drink for me, too.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000924:text","row":27992,"ordinal":25,"kind":"text","jp":"「これなど」","en":"“Perhaps this.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011337","unitId":"ghs-tl:ccc0009:00025","en":"Miki: \"Something like this!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000950:text","row":27993,"ordinal":26,"kind":"text","jp":"「相変わらずのレアリティの高いドリンクチョイス、ありがとう」","en":"“Thanks for once again choosing a drink of exceptional rarity.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011338","unitId":"ghs-tl:ccc0009:00026","en":"Taichi: \"As always a Drink Choice of high rarity, thank you.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000009a4:text","row":27994,"ordinal":27,"kind":"text","jp":"知る人ぞ知るネー○ンだった。","en":"It was Ne-○n, known only to those in the know.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011339","unitId":"ghs-tl:ccc0009:00027","en":"Those in the know know it well, it was Nee**n.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000009d8:text","row":27995,"ordinal":28,"kind":"text","jp":"飲み干す！　一気にだ！","en":"I drained it! All in one go!","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011340","unitId":"ghs-tl:ccc0009:00028","en":"Chug it! One gulp!","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000a8c:text","row":27996,"ordinal":29,"kind":"text","jp":"「賞味期限とか見ない方がいいです」","en":"“You probably shouldn’t check the best-by date.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011341","unitId":"ghs-tl:ccc0009:00029","en":"Miki: \"Best drunk before looking at the expiration date.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000ace:text","row":27997,"ordinal":30,"kind":"text","jp":"「ゲハァっ！」","en":"“Bghaaah!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011342","unitId":"ghs-tl:ccc0009:00030","en":"Taichi: \"G'blagh!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000af4:text","row":27998,"ordinal":31,"kind":"text","jp":"気管に入った。","en":"It went down the wrong pipe.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011343","unitId":"ghs-tl:ccc0009:00031","en":"It had entered the trachea.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000b22:text","row":27999,"ordinal":32,"kind":"text","jp":"「げほっ、がほっ！」","en":"“Cough—hack!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011344","unitId":"ghs-tl:ccc0009:00032","en":"Taichi: \"G'khoff, g'khaff!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000bd4:text","row":28000,"ordinal":33,"kind":"text","jp":"「スマッシュヒット」","en":"“Smash hit.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011345","unitId":"ghs-tl:ccc0009:00033","en":"Miki: \"Smash hit!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000c00:text","row":28001,"ordinal":34,"kind":"text","jp":"ポージング。","en":"She struck a pose.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011346","unitId":"ghs-tl:ccc0009:00034","en":"And posing.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000c2c:text","row":28002,"ordinal":35,"kind":"text","jp":"「……人をはめるな！」","en":"“…Don’t set me up like that!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011347","unitId":"ghs-tl:ccc0009:00035","en":"Taichi: \"...don't read-icule people!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000ce0:text","row":28003,"ordinal":36,"kind":"text","jp":"「すいませーん」","en":"“Sor-ry.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011348","unitId":"ghs-tl:ccc0009:00036","en":"Miki: \"Sorryyy.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000d08:text","row":28004,"ordinal":37,"kind":"text","jp":"にへらっとふやける。","en":"Her face melted into a foolish grin.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011349","unitId":"ghs-tl:ccc0009:00037","en":"She drenches herself with a flippant smirk.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000d3c:text","row":28005,"ordinal":38,"kind":"text","jp":"「ケッ、このおぼこがっ」","en":"“Tch. You little virgin.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011350","unitId":"ghs-tl:ccc0009:00038","en":"Taichi: \"Tch, this oboko here!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000d6c:text","row":28006,"ordinal":39,"kind":"text","jp":"吐き捨てる。","en":"I spat the words.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011351","unitId":"ghs-tl:ccc0009:00039","en":"I spat her way.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000e16:text","row":28007,"ordinal":40,"kind":"text","jp":"「二十歳までには捨てようと思います」","en":"“I plan to lose it before I’m twenty.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011352","unitId":"ghs-tl:ccc0009:00040","en":"Miki: \"I think I'll want to discard that before I turn twenty.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000e5a:text","row":28008,"ordinal":41,"kind":"text","jp":"「そもそも二十歳になるな」","en":"“Don’t ever turn twenty.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011353","unitId":"ghs-tl:ccc0009:00041","en":"Taichi: \"Don't become twenty years old in the first place!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000f12:text","row":28009,"ordinal":42,"kind":"text","jp":"「え？」","en":"“Huh?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011354","unitId":"ghs-tl:ccc0009:00042","en":"Miki: \"Eh?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000f3a:text","row":28010,"ordinal":43,"kind":"text","jp":"「永遠の今でいろ」","en":"“Stay forever in the eternal now.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011355","unitId":"ghs-tl:ccc0009:00043","en":"Taichi: \"Live like now for all eternity.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00000fea:text","row":28011,"ordinal":44,"kind":"text","jp":"「……できそうな気もしますが無理です」","en":"“…It feels like I could, but I can’t.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011356","unitId":"ghs-tl:ccc0009:00044","en":"Miki: \"...I feel like I could, but that's impossible.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001028:text","row":28012,"ordinal":45,"kind":"text","jp":"だろうな。","en":"I figured.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011357","unitId":"ghs-tl:ccc0009:00045","en":"Isn't it now.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000104a:text","row":28013,"ordinal":46,"kind":"text","jp":"いやそれよりも。","en":"No—more importantly.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011358","unitId":"ghs-tl:ccc0009:00046","en":"No, wait, more importantly,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000107a:text","row":28014,"ordinal":47,"kind":"text","jp":"「で、誰にあげるの？」","en":"“So who are you going to give it to?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011359","unitId":"ghs-tl:ccc0009:00047","en":"Taichi: \"So, who're you giving it to?\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000112e:text","row":28015,"ordinal":48,"kind":"text","jp":"「……え？　うーん……ファルコン加藤」","en":"“…Huh? Hmm… Falcon Kato.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011360","unitId":"ghs-tl:ccc0009:00048","en":"Miki: \"...eh? Hummm... Falcon Katou.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001174:text","row":28016,"ordinal":49,"kind":"text","jp":"「テクニック重視かよ！」","en":"“You’re choosing based on technique?!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011361","unitId":"ghs-tl:ccc0009:00049","en":"Taichi: \"So much emphasis on the technique!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000011a4:text","row":28017,"ordinal":50,"kind":"text","jp":"嘆いた。","en":"I wailed.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011362","unitId":"ghs-tl:ccc0009:00050","en":"I sighed.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000011c4:text","row":28018,"ordinal":51,"kind":"text","jp":"日本有数のテクニシャンじゃねぇか。","en":"He was one of the best technicians in Japan.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011363","unitId":"ghs-tl:ccc0009:00051","en":"Ain't he Japan's foremost Technician now.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000011fe:text","row":28019,"ordinal":52,"kind":"text","jp":"……勝てない。","en":"…I couldn’t compete.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011364","unitId":"ghs-tl:ccc0009:00052","en":"...I'd never beat him.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000122c:text","row":28020,"ordinal":53,"kind":"text","jp":"「ファルコンには及ばないが、俺も技術には自身がある」","en":"“I may not be a match for Falcon, but I’ve got plenty of technique myself.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011365","unitId":"ghs-tl:ccc0009:00053","en":"Taichi: \"I may not be at the levels of Falcon, but I have quite confidence in my techniques, indeed.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000012fe:text","row":28021,"ordinal":54,"kind":"text","jp":"「先輩の技術はセクハラばかりで、本番で役に立つのかたいへん不安な面もございますので、申し訳ありませんがお断りだ」","en":"“Your technique consists almost entirely of sexual harassment, and I have grave concerns about whether it would be of any use when the real thing comes along. My apologies, but no.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011366","unitId":"ghs-tl:ccc0009:00054","en":"Miki: \"Senpai, your techniques are exclusively for sexual harassment, so whether they are of use in principal photography is an aspect I am significantly uncertain about, and therefore, my deepest and most sincere apologies, but it ain't happening.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001386:text","row":28022,"ordinal":55,"kind":"text","jp":"語尾がタメ口になるほどのますらおぶり。","en":"Such fearless valor, she even dropped the polite speech for the last word.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011367","unitId":"ghs-tl:ccc0009:00055","en":"She's so warrior-like when she ends all that on something that casual.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000013c4:text","row":28023,"ordinal":56,"kind":"text","jp":"その断りっぷりに、俺の心はブロークンがちだ。","en":"That masterful rejection left my heart trending broken.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011368","unitId":"ghs-tl:ccc0009:00056","en":"That style of rejection just makes my heart more and more Broken.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001410:text","row":28024,"ordinal":57,"kind":"text","jp":"「ちっ、そんなこと言って、本当は霧ちんに捧げようとしてるんじゃないか？　この淫乱処女が」","en":"“Tch. You say that, but you’re really planning to offer it to Kiri-kins, aren’t you? You horny virgin.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011369","unitId":"ghs-tl:ccc0009:00057","en":"Taichi: \"Tch, you say all that, but the truth is that you will offer it to Kiri-chin, won't you? You debauched virgin...!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001506:text","row":28025,"ordinal":58,"kind":"text","jp":"「むしろ霧ちんの処女を奪います」","en":"“I’m going to take Kiri-kins’s virginity instead.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011370","unitId":"ghs-tl:ccc0009:00058","en":"Miki: \"More like I'll be snatching Kiri-chin's virginity away.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001546:text","row":28026,"ordinal":59,"kind":"text","jp":"「あっ、ソレ参加したいっ」","en":"“Ah! I want in on that!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011371","unitId":"ghs-tl:ccc0009:00059","en":"Taichi: \"Awww, I wanna join in to that!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001578:text","row":28027,"ordinal":60,"kind":"text","jp":"欲望が多重化している俺の、ミーハー度は８２％と高めだ。","en":"With my desires now multiplying, my bandwagon index stood at an elevated 82 percent.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011372","unitId":"ghs-tl:ccc0009:00060","en":"The desires that are multiplexing in me raise my Fad Chaser levels to 82%.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000164c:text","row":28028,"ordinal":61,"kind":"text","jp":"「そんなわけで一緒に通学しましょー」","en":"“And with that, let’s walk to school together.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011373","unitId":"ghs-tl:ccc0009:00061","en":"Miki: \"And with that, let's go to school togetheeer!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001690:text","row":28029,"ordinal":62,"kind":"text","jp":"「うん、行こう」","en":"“Yeah. Let’s go.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011374","unitId":"ghs-tl:ccc0009:00062","en":"Taichi: \"Yeah, let's go.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:0000179b:text","row":28030,"ordinal":63,"kind":"text","jp":"手を繋いで二人で学校に。","en":"Hand in hand, the two of us set off for school.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011375","unitId":"ghs-tl:ccc0009:00063","en":"The two of us go to school with linked hands.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000017d3:text","row":28031,"ordinal":64,"kind":"text","jp":"「あおぞらのしたで～♪」","en":"“Beneath the bluuue skyyy ♪”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011376","unitId":"ghs-tl:ccc0009:00064","en":"Taichi: \"Oh, under this blue sky～♪\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001889:text","row":28032,"ordinal":65,"kind":"text","jp":"「なかよくふたり～♪」","en":"“Two good friends, side by siiiide ♪”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011377","unitId":"ghs-tl:ccc0009:00065","en":"Miki: \"How well together we go～♪\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:000018b7:text","row":28033,"ordinal":66,"kind":"text","jp":"のんきにデュエットしながら、のんびり登校した。","en":"We ambled to school at our leisure, singing our carefree duet.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011378","unitId":"ghs-tl:ccc0009:00066","en":"A carefree duet while we leisurely went to school.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001983:text","row":28034,"ordinal":67,"kind":"text","jp":"「…………」","en":"“…………”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011379","unitId":"ghs-tl:ccc0009:00067","en":"Miki: \"......\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001b7e:text","row":28035,"ordinal":68,"kind":"text","jp":"「あ、いけね。霧ちーの飲み物忘れました」","en":"“Oh, crap. I forgot Kiri’s drink.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011380","unitId":"ghs-tl:ccc0009:00068","en":"Miki: \"Ah, silly me. I totally forgot about Kirichy's drink.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001bbe:text","row":28036,"ordinal":69,"kind":"text","jp":"学校にまで到着して、そんなことを言う。","en":"She announced this only after we had made it all the way to school.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011381","unitId":"ghs-tl:ccc0009:00069","en":"We had come all the way to school when she said that.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001c04:text","row":28037,"ordinal":70,"kind":"text","jp":"「愚か者め。修行が足りぬ」","en":"“Fool. Your training is sorely lacking.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011382","unitId":"ghs-tl:ccc0009:00070","en":"Taichi: \"Damnable fool. Your discipline is inadequate!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001cbc:text","row":28038,"ordinal":71,"kind":"text","jp":"「戻ります」","en":"“I’m going back.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011383","unitId":"ghs-tl:ccc0009:00071","en":"Miki: \"Going back.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001ce8:text","row":28039,"ordinal":72,"kind":"text","jp":"「好きなだけ坂をのぼりおりするんだよ」","en":"“Go up and down that hill to your heart’s content.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011384","unitId":"ghs-tl:ccc0009:00072","en":"Taichi: \"Go up and down those slopes as much as you like!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001d4b:text","row":28040,"ordinal":73,"kind":"text","jp":"「へーい」","en":"“Okaaay.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:011385","unitId":"ghs-tl:ccc0009:00073","en":"Miki: \"Heeey!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001e25:text","row":28041,"ordinal":74,"kind":"text","jp":"軽快に駆けていく。","en":"She went bounding off.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011386","unitId":"ghs-tl:ccc0009:00074","en":"A nimble gallop.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001e4f:text","row":28042,"ordinal":75,"kind":"text","jp":"うい奴。","en":"What a charmer.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:011387","unitId":"ghs-tl:ccc0009:00075","en":"Gay gal.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0175:00001e77:text","row":28043,"ordinal":76,"kind":"text","jp":"「……」","en":"“……”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:011388","unitId":"ghs-tl:ccc0009:00076","en":"Taichi: \"...\"","verdict":"acceptable","categories":["word_choice"]}]}]}

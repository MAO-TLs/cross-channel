{"schema":"mao-cross-channel-public-site-data/1","script":"0263","rows":[{"ref":"ccfc:sn:0263:000000ed:text","row":36046,"ordinal":1,"kind":"text","jp":"部活。","en":"Club activities.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900811","unitId":"ghs-tl:ccc4004:00001","en":"Club activities.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000010b:text","row":36047,"ordinal":2,"kind":"text","jp":"物陰から美希が飛び出た。","en":"Miki burst from cover.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900812","unitId":"ghs-tl:ccc4004:00002","en":"Miki flew out from under cover.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000013b:text","row":36048,"ordinal":3,"kind":"text","jp":"俺の目は逃さない。","en":"I caught the movement.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900813","unitId":"ghs-tl:ccc4004:00003","en":"She cannot escape my eyes.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000248:text","row":36049,"ordinal":4,"kind":"text","jp":"手にしたウージーサブマシンガンのトリガーを絞る。","en":"I squeezed the trigger of my Uzi submachine gun.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900814","unitId":"ghs-tl:ccc4004:00004","en":"I squeeze the trigger of the Uzi SMG in my hands,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000290:text","row":36050,"ordinal":5,"kind":"text","jp":"弾丸が射出される。","en":"The gun spat bullets.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900815","unitId":"ghs-tl:ccc4004:00005","en":"making it fire its bullets.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000002ba:text","row":36051,"ordinal":6,"kind":"text","jp":"射線はそれて美希の足下を叩いた。","en":"My burst went wide and chewed up the ground at Miki's feet.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900816","unitId":"ghs-tl:ccc4004:00006","en":"Line of fire strays, striking Miki's underfoot.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000317:text","row":36052,"ordinal":7,"kind":"text","jp":"「……く！？」","en":"“...Kh!?”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900817","unitId":"ghs-tl:ccc4004:00007","en":"Miki: \"...ngh?!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000033d:text","row":36053,"ordinal":8,"kind":"text","jp":"美希が気づく。","en":"Miki saw me.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900818","unitId":"ghs-tl:ccc4004:00008","en":"Miki notices,","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000363:text","row":36054,"ordinal":9,"kind":"text","jp":"植木の影に飛び込み、応戦してくる。","en":"She dove behind a shrub and returned fire.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900819","unitId":"ghs-tl:ccc4004:00009","en":"and diving behind a planter, she fights back.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000039d:text","row":36055,"ordinal":10,"kind":"text","jp":"まずい、釘付けだ！","en":"Damn, I was pinned!","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900820","unitId":"ghs-tl:ccc4004:00010","en":"This is bad, I'm being suppressed!","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000003c7:text","row":36056,"ordinal":11,"kind":"text","jp":"側面からみみ先輩が顔を出す。","en":"Mimi appeared on my flank.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900821","unitId":"ghs-tl:ccc4004:00011","en":"Mimi-senpai juts out her face from the flank.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000003fb:text","row":36057,"ordinal":12,"kind":"text","jp":"ＡＫ４７から空になった弾倉を取り外す。","en":"She dropped the empty magazine from her AK-47.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900822","unitId":"ghs-tl:ccc4004:00012","en":"She takes out the empty magazine of her AK-47.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000045e:text","row":36058,"ordinal":13,"kind":"text","jp":"「佐倉さんがいません～っ」","en":"“I can't find Sakura!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900823","unitId":"ghs-tl:ccc4004:00013","en":"Misato: \"Sakura-san is nowhe～re!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000498:text","row":36059,"ordinal":14,"kind":"text","jp":"「見失ったんですか！」","en":"“You lost her?”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900824","unitId":"ghs-tl:ccc4004:00014","en":"Taichi: \"Did you lose sight of her!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000004eb:text","row":36060,"ordinal":15,"kind":"text","jp":"「彼女、身軽で……」","en":"“She's too nimble...”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900825","unitId":"ghs-tl:ccc4004:00015","en":"Misato: \"She is so agile...\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000051f:text","row":36061,"ordinal":16,"kind":"text","jp":"「くっ……まずいな」","en":"“Damn... This is bad.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900826","unitId":"ghs-tl:ccc4004:00016","en":"Taichi: \"Tsk... this looks bad.\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000054b:text","row":36062,"ordinal":17,"kind":"text","jp":"敵を見失うのはまずい。","en":"Losing sight of the enemy was never good.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900827","unitId":"ghs-tl:ccc4004:00017","en":"Losing sight of an enemy is always bad.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000579:text","row":36063,"ordinal":18,"kind":"text","jp":"と、霧が右側からまわこんできた。","en":"Then Kiri swept in from the right.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900828","unitId":"ghs-tl:ccc4004:00018","en":"And, Kiri sneaked around from the right side.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000005b1:text","row":36064,"ordinal":19,"kind":"text","jp":"まずい、挟み撃ちになる。","en":"Damn. They were about to catch us in a pincer.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900829","unitId":"ghs-tl:ccc4004:00019","en":"Very bad, we'll get pincered!","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000005e1:text","row":36065,"ordinal":20,"kind":"text","jp":"霧のＭ４Ａ１カービンが火を噴いた。","en":"Kiri's M4A1 carbine spat fire.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900830","unitId":"ghs-tl:ccc4004:00020","en":"Kiri's M4-A1 Carbine breathed fire.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000640:text","row":36066,"ordinal":21,"kind":"text","jp":"「あっ、やられましたー」","en":"“Ah! I'm hit!”","speakerJa":"見里","speakerEn":"Misato","ghs":[{"id":"ghs-tl:finding:900831","unitId":"ghs-tl:ccc4004:00021","en":"Misato: \"Ah, I have been killed!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000678:text","row":36067,"ordinal":22,"kind":"text","jp":"「シット！」","en":"“Shit!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900832","unitId":"ghs-tl:ccc4004:00022","en":"Taichi: \"Shit!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000069c:text","row":36068,"ordinal":23,"kind":"text","jp":"二対一だ。","en":"Two against one.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900833","unitId":"ghs-tl:ccc4004:00023","en":"It's two against one.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000006be:text","row":36069,"ordinal":24,"kind":"text","jp":"俺は応射しながら後退する。","en":"I retreated, firing back.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900834","unitId":"ghs-tl:ccc4004:00024","en":"I fall back as I return fire.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000006f0:text","row":36070,"ordinal":25,"kind":"text","jp":"挟まれたら終わる。","en":"If they caught me between them, I was finished.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900835","unitId":"ghs-tl:ccc4004:00025","en":"If I get in their pincer it's over.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000071a:text","row":36071,"ordinal":26,"kind":"text","jp":"側面の美希も気になる。","en":"And Miki was still on my flank.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900836","unitId":"ghs-tl:ccc4004:00026","en":"Miki, on the flank, also worries me.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000074d:text","row":36072,"ordinal":27,"kind":"text","jp":"その時、背後に銃口を突きつけられた。","en":"Then I felt a muzzle pressed to my back.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900837","unitId":"ghs-tl:ccc4004:00027","en":"That instant, a muzzle was thrust in my back.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000007ae:text","row":36073,"ordinal":28,"kind":"text","jp":"「ほーるどあっぷ」","en":"“Haaands up.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900838","unitId":"ghs-tl:ccc4004:00028","en":"Miki: \"'Holdo appu!'\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000007d8:text","row":36074,"ordinal":29,"kind":"text","jp":"い、いつの間に！","en":"Wh-when did she—!?","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900839","unitId":"ghs-tl:ccc4004:00029","en":"Wh-, when did she...!","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000825:text","row":36075,"ordinal":30,"kind":"text","jp":"「ゲームセットです」","en":"“Game over.”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900840","unitId":"ghs-tl:ccc4004:00030","en":"Miki: \"Game and set!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000859:text","row":36076,"ordinal":31,"kind":"text","jp":"「あー、またやられたー！」","en":"“Aww, I got taken out again!”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900841","unitId":"ghs-tl:ccc4004:00031","en":"Taichi: \"Ahhh, killed agaaain!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000008b0:text","row":36077,"ordinal":32,"kind":"text","jp":"「やっほーい！」","en":"“Woohoo!”","speakerJa":"美希","speakerEn":"Miki","ghs":[{"id":"ghs-tl:finding:900842","unitId":"ghs-tl:ccc4004:00032","en":"Miki: \"Yahoooy!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:000008fb:text","row":36078,"ordinal":33,"kind":"text","jp":"「かちー！」","en":"“We win!”","speakerJa":"霧","speakerEn":"Kiri","ghs":[{"id":"ghs-tl:finding:900843","unitId":"ghs-tl:ccc4004:00033","en":"Miki: \"Victoryyy!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000091f:text","row":36079,"ordinal":34,"kind":"text","jp":"美希と霧はハイタッチをする。","en":"Miki and Kiri high-fived.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900844","unitId":"ghs-tl:ccc4004:00034","en":"Miki and Kiri go for a high-five.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:0000095b:text","row":36080,"ordinal":35,"kind":"text","jp":"「これで四連敗だぞ……ちぇっ」","en":"“That’s four losses in a row... Damn it.”","speakerJa":"太一","speakerEn":"Taichi","ghs":[{"id":"ghs-tl:finding:900845","unitId":"ghs-tl:ccc4004:00035","en":"Taichi: \"This is the fourth defeat in a row... grrr!\"","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000991:text","row":36081,"ordinal":36,"kind":"text","jp":"部活は順調だった。","en":"Club activities were going smoothly.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900846","unitId":"ghs-tl:ccc4004:00036","en":"Club activities were going well.","verdict":"acceptable","categories":["word_choice"]}]},{"ref":"ccfc:sn:0263:00000a91:text","row":36082,"ordinal":37,"kind":"text","jp":"…………あれ。","en":"...Wait.","speakerJa":"","speakerEn":"","ghs":[{"id":"ghs-tl:finding:900847","unitId":"ghs-tl:ccc4004:00037","en":"......wait.","verdict":"acceptable","categories":["word_choice"]}]}]}
